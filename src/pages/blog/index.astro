---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((p) => !p.id.startsWith('case-study-'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
	title="Blog AI dla firm – Digital Impact"
	description="Praktyczne artykuły o AI dla firm. Automatyzacje, koszty, case studies – konkretnie i bez żargonu."
>
	<Nav current="blog" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<h1 class="hero__title">Blog</h1>
			<p class="hero__subtitle">Praktycznie o AI dla firm.</p>
		</div>
	</section>

	<!-- ARTYKUŁY -->
	<section class="posts-section">
		<div class="container">
			<div class="posts">
				{posts.map((post) => (
					<article class="card">
						<div class="card__meta">
							{post.data.kategoria && (
								<span class="card__tag">{post.data.kategoria}</span>
							)}
							{post.data.czas_czytania && (
								<span class="card__time">⏱ {post.data.czas_czytania}</span>
							)}
						</div>
						<h2 class="card__title">
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
						</h2>
						{post.data.description && (
							<p class="card__desc">{post.data.description}</p>
						)}
						<a href={`/blog/${post.id}`} class="btn btn--accent">Czytaj artykuł</a>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>


<style>
	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: var(--color-primary);
		margin: 0 0 1rem;
		line-height: 1.15;
	}

	.hero__subtitle {
		font-size: clamp(1.125rem, 2.5vw, 1.375rem);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* POSTS */
	.posts-section {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.posts {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.card {
		border-top: 3px solid var(--color-accent);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.card__meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		flex-wrap: wrap;
	}

	.card__tag {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		background-color: rgba(45, 126, 248, 0.08);
		padding: 0.25rem 0.625rem;
		border-radius: 999px;
	}

	.card__time {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.card__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		line-height: 1.3;
		margin: 0;
	}

	.card__title a {
		color: inherit;
		text-decoration: none;
	}

	.card__title a:hover { color: var(--color-accent); }

	.card__desc {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin: 0;
		flex: 1;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 0.9375rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
		align-self: flex-start;
	}

	.btn:hover { opacity: 0.88; }
	.btn--accent { background-color: var(--color-accent); color: var(--color-white); }

	/* DESKTOP */
	@media (min-width: 768px) {
		.posts {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
