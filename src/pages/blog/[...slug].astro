---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { entry: post },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, kategoria, czas_czytania } = entry.data;
---

<Layout title={`${title} — Digital Impact`} description={description ?? ''}>
	<!-- NAWIGACJA -->
	<nav class="nav">
		<div class="nav__container">
			<a href="/" class="nav__logo"><img src="/logo.svg" alt="Digital Impact AI Consulting" height="44" style="display:block; height:44px; width:auto;"></a>
			<button class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<ul class="nav__menu" id="nav-menu" role="list">
				<li><a href="/#oferta">Oferta</a></li>
				<li><a href="/proces">Proces</a></li>
				<li><a href="/case-studies">Case Studies</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/o-mnie">O mnie</a></li>
				<li><a href="/kontakt">Kontakt</a></li>
			</ul>
		</div>
	</nav>

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<a href="/blog" class="back-link">← Blog</a>
			<div class="hero__meta">
				{kategoria && <span class="hero__tag">{kategoria}</span>}
				{czas_czytania && <span class="hero__time">⏱ {czas_czytania}</span>}
			</div>
			<h1 class="hero__title">{title}</h1>
		</div>
	</section>

	<!-- TREŚĆ -->
	<article class="content-section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Masz pytania? Porozmawiajmy.</h2>
			<a href="/kontakt" class="btn btn--accent">Umów bezpłatną konsultację</a>
		</div>
	</section>
</Layout>

<script>
	const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
	const menu = document.querySelector<HTMLUListElement>('.nav__menu');

	hamburger?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('nav__menu--open');
		hamburger.setAttribute('aria-expanded', String(isOpen));
	});

	document.querySelectorAll('.nav__menu a').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.remove('nav__menu--open');
			hamburger?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.container {
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* NAV */
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--color-white);
		box-shadow: var(--shadow-sm);
	}

	.nav__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin-inline: auto;
		padding: 0.75rem 1.5rem;
		min-height: 64px;
		position: relative;
	}

	.nav__logo { text-decoration: none; line-height: 0; padding: 0; }

	.nav__hamburger {
		display: flex;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.375rem;
	}

	.nav__hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-primary);
		border-radius: 2px;
	}

	.nav__menu {
		display: none;
		flex-direction: column;
		list-style: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background-color: var(--color-white);
		box-shadow: var(--shadow-md);
		padding: 0.5rem 1.25rem 1.25rem;
		margin: 0;
	}

	.nav__menu--open { display: flex; }

	.nav__menu a {
		display: block;
		padding: 0.75rem 0;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
		border-bottom: 1px solid var(--color-surface);
	}

	.nav__menu li:last-child a { border-bottom: none; }

	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 3rem 1.5rem 2rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;
		margin-bottom: 1rem;
	}

	.back-link:hover { opacity: 0.8; }

	.hero__meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.875rem;
		flex-wrap: wrap;
	}

	.hero__tag {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		background-color: rgba(45, 126, 248, 0.08);
		padding: 0.25rem 0.625rem;
		border-radius: 999px;
	}

	.hero__time {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.hero__title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.2;
		margin: 0;
		max-width: 820px;
	}

	/* CONTENT */
	.content-section {
		background-color: var(--color-white);
		padding: 3rem 1.5rem 4rem;
	}

	.prose {
		max-width: 760px;
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.prose :global(h2) {
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 2.5rem 0 1rem;
		line-height: 1.25;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 1.75rem 0 0.75rem;
	}

	.prose :global(p) { margin: 0 0 1.25rem; }

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1.25rem;
	}

	.prose :global(li) { margin-bottom: 0.5rem; }

	.prose :global(strong) {
		font-weight: 700;
		color: var(--color-primary);
	}

	.prose :global(a) {
		color: var(--color-accent);
		text-decoration: none;
	}

	.prose :global(a:hover) { text-decoration: underline; }

	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--color-surface);
		margin: 2rem 0;
	}

	/* CTA */
	.cta-section {
		background-color: var(--color-primary);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.cta-section__title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--color-white);
		margin: 0 0 2rem;
		line-height: 1.3;
	}

	.btn {
		display: inline-block;
		padding: 0.875rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
	}

	.btn:hover { opacity: 0.88; }
	.btn--accent { background-color: var(--color-accent); color: var(--color-white); }

	/* DESKTOP */
	@media (min-width: 768px) {
		.nav__hamburger { display: none; }

		.nav__menu {
			display: flex;
			flex-direction: row;
			position: static;
			box-shadow: none;
			padding: 0;
			gap: 2rem;
		}

		.nav__menu a {
			padding: 0;
			border-bottom: none;
			font-size: 0.9375rem;
		}

		.nav__menu a:hover { color: var(--color-accent); }
	}
</style>
