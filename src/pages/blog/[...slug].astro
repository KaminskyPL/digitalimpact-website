---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { entry: post },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, kategoria, czas_czytania, pubDate } = entry.data;
const pubDateFormatted = pubDate.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
	title={`${title} – Digital Impact`}
	description={description ?? ''}
	ogType="article"
	ogDate={pubDate.toISOString()}
>
	<Nav current="blog" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<div class="hero__inner">
				<a href="/blog" class="back-link">← Blog</a>
				<div class="hero__meta">
					{kategoria && <span class="hero__tag">{kategoria}</span>}
					{czas_czytania && <span class="hero__time">⏱ {czas_czytania}</span>}
					<time class="hero__date" datetime={pubDate.toISOString().split('T')[0]}>{pubDateFormatted}</time>
				</div>
				<h1 class="hero__title">{title}</h1>
			</div>
		</div>
	</section>

	<!-- TREŚĆ -->
	<article class="content-section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Masz pytania? Porozmawiajmy.</h2>
			<a href="/kontakt" class="btn btn--accent">Umów bezpłatną konsultację</a>
		</div>
	</section>

	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		"headline": title,
		"description": description ?? '',
		"datePublished": pubDate.toISOString(),
		"dateModified": pubDate.toISOString(),
		"author": {
			"@type": "Person",
			"name": "Kamil Kiersnowski",
			"url": "https://digitalimpact.pl/o-mnie"
		},
		"publisher": {
			"@type": "Organization",
			"name": "Digital Impact",
			"url": "https://digitalimpact.pl",
			"logo": {
				"@type": "ImageObject",
				"url": "https://digitalimpact.pl/logo.svg"
			}
		},
		"url": `https://digitalimpact.pl/blog/${entry.id}`,
		"mainEntityOfPage": `https://digitalimpact.pl/blog/${entry.id}`
	})} />
</Layout>

<style>
	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 3rem 1.5rem 2rem;
	}


	.hero__meta {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 0.875rem;
		flex-wrap: wrap;
	}

	.hero__tag {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		background-color: rgba(45, 126, 248, 0.08);
		padding: 0.25rem 0.625rem;
		border-radius: 999px;
	}

	.hero__time {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.hero__date {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		font-weight: 400;
	}

	.hero__title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.2;
		margin: 0;
	}

	/* CONTENT */
	.content-section {
		background-color: var(--color-white);
		padding: 3rem 1.5rem 4rem;
	}

	.hero__inner {
		max-width: 760px;
		margin-inline: auto;
	}

	.prose {
		max-width: 760px;
		margin-inline: auto;
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.prose :global(h2) {
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 2.5rem 0 1rem;
		line-height: 1.25;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 1.75rem 0 0.75rem;
	}

	.prose :global(p) { margin: 0 0 1.25rem; }

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1.25rem;
	}

	.prose :global(li) { margin-bottom: 0.5rem; }

	.prose :global(strong) {
		font-weight: 700;
		color: var(--color-primary);
	}

	.prose :global(a) {
		color: var(--color-accent);
		text-decoration: none;
	}

	.prose :global(a:hover) { text-decoration: underline; }

	.prose :global(hr) {
		border: none;
		border-top: 1px solid var(--color-surface);
		margin: 2rem 0;
	}


</style>
