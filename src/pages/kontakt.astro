---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Kontakt – Digital Impact"
	description="Skontaktuj się z Digital Impact. Telefon, email, formularz kontaktowy i dane firmy."
>
	<!-- NAWIGACJA -->
	<nav class="nav">
		<div class="nav__container">
			<a href="/" class="nav__logo"><img src="/logo.svg" alt="Digital Impact AI Consulting" height="44" style="display:block; height:44px; width:auto;"></a>
			<button class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<ul class="nav__menu" id="nav-menu" role="list">
				<li><a href="/#oferta">Oferta</a></li>
				<li><a href="/proces">Proces</a></li>
				<li><a href="/case-studies">Case Studies</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/o-mnie">O mnie</a></li>
				<li><a href="/kalkulator-roi">Kalkulator ROI</a></li>
				<li><a href="/kontakt" aria-current="page">Kontakt</a></li>
			</ul>
		</div>
	</nav>

	<!-- KONTAKT -->
	<section class="kontakt-section">
		<div class="container">
			<div class="kontakt-grid">

				<!-- LEWA KOLUMNA -->
				<div class="info-col">
					<h1 class="info__title">Kontakt</h1>
					<p class="info__lead">Napisz, zadzwoń lub wypełnij formularz – odezwę się w ciągu 24 godzin.</p>

					<div class="info-block">
						<h2 class="info-block__heading">Dane firmy</h2>
						<address class="info-block__address">
							Digital Impact Kamil Kiersnowski<br>
							ul. Sowlańska 42/22<br>
							15-560 Białystok<br>
							<br>
							NIP: 5432071736<br>
							REGON: 200661540
						</address>
					</div>

					<div class="info-block">
						<h2 class="info-block__heading">Kontakt bezpośredni</h2>
						<ul class="info-block__list">
							<li>
								<span class="info-block__icon">📞</span>
								<a href="tel:+48696480318" class="info-block__link">+48 696 480 318</a>
							</li>
							<li>
								<span class="info-block__icon">✉️</span>
								<span id="email-wrap"></span>
							</li>
							<li>
								<span class="info-block__icon">🕐</span>
								<span class="info-block__text">pon.–pt. 9:00–17:00</span>
							</li>
						</ul>
					</div>
				</div>

				<!-- PRAWA KOLUMNA -->
				<div class="form-col">
					<h2 class="form-col__heading">Napisz do mnie</h2>
					<form class="form" id="contact-form" name="kontakt" action="https://formspree.io/f/xdajlkrp" method="POST">
						<input type="hidden" name="_language" value="pl" />
						<div class="form__group">
							<label for="imie">Imię</label>
							<input type="text" id="imie" name="imie" required placeholder="Twoje imię" />
						</div>
						<div class="form__group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required placeholder="twoj@email.pl" />
						</div>
						<div class="form__group">
							<label for="wiadomosc">Wiadomość</label>
							<textarea
								id="wiadomosc"
								name="wiadomosc"
								rows="6"
								required
								placeholder="Opowiedz mi o swojej firmie i wyzwaniach..."></textarea>
						</div>
						<button type="submit" class="btn btn--accent btn--full">Wyślij wiadomość</button>
					</form>
					<p id="form-success" style="display:none; color: var(--color-accent); margin-top: 1rem; font-weight: 500;">
						Dziękuję! Odezwę się w ciągu 24 godzin.
					</p>
				</div>

			</div>
		</div>
	</section>
</Layout>

<script>
	// Hamburger menu
	const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
	const menu = document.querySelector<HTMLUListElement>('.nav__menu');

	hamburger?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('nav__menu--open');
		hamburger.setAttribute('aria-expanded', String(isOpen));
	});

	document.querySelectorAll('.nav__menu a').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.remove('nav__menu--open');
			hamburger?.setAttribute('aria-expanded', 'false');
		});
	});

	// Email obfuscation
	const u = 'kontakt';
	const d = 'digitalimpact.pl';
	const el = document.getElementById('email-wrap');
	if (el) el.innerHTML = '<a href="mailto:' + u + '@' + d + '" class="info-block__link">' + u + '@' + d + '</a>';

	// Form submission
	const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
	const formSuccess = document.querySelector<HTMLElement>('#form-success');

	contactForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const submitBtn = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');

		if (submitBtn) {
			submitBtn.textContent = 'Wysyłanie...';
			submitBtn.disabled = true;
			submitBtn.style.opacity = '0.7';
		}

		const data = new FormData(contactForm);
		try {
			const res = await fetch(contactForm.action, {
				method: 'POST',
				body: data,
				headers: { Accept: 'application/json' },
			});
			if (res.ok) {
				if (submitBtn) {
					submitBtn.textContent = 'Wyślij wiadomość';
					submitBtn.disabled = false;
					submitBtn.style.opacity = '1';
				}
				contactForm.style.display = 'none';
				if (formSuccess) formSuccess.style.display = 'block';
			} else {
				if (submitBtn) {
					submitBtn.textContent = 'Wyślij wiadomość';
					submitBtn.disabled = false;
					submitBtn.style.opacity = '1';
				}
				alert('Coś poszło nie tak. Spróbuj napisać bezpośrednio na: kontakt@digitalimpact.pl');
			}
		} catch {
			if (submitBtn) {
				submitBtn.textContent = 'Wyślij wiadomość';
				submitBtn.disabled = false;
				submitBtn.style.opacity = '1';
			}
			alert('Coś poszło nie tak. Spróbuj napisać bezpośrednio na: kontakt@digitalimpact.pl');
		}
	});
</script>

<style>
	.container {
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* NAV */
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--color-white);
		box-shadow: var(--shadow-sm);
	}

	.nav__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin-inline: auto;
		padding: 0.75rem 1.5rem;
		min-height: 64px;
		position: relative;
	}

	.nav__logo {
		text-decoration: none;
		line-height: 0;
		padding: 0;
	}

	.nav__hamburger {
		display: flex;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.375rem;
	}

	.nav__hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-primary);
		border-radius: 2px;
	}

	.nav__menu {
		display: none;
		flex-direction: column;
		list-style: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background-color: var(--color-white);
		box-shadow: var(--shadow-md);
		padding: 0.5rem 1.25rem 1.25rem;
		margin: 0;
	}

	.nav__menu--open { display: flex; }

	.nav__menu a {
		display: block;
		padding: 0.75rem 0;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
		border-bottom: 1px solid var(--color-surface);
	}

	.nav__menu a[aria-current='page'] { color: var(--color-accent); }
	.nav__menu li:last-child a { border-bottom: none; }

	/* KONTAKT SECTION */
	.kontakt-section {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
		min-height: calc(100vh - 64px);
	}

	.kontakt-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* LEWA KOLUMNA */
	.info-col {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.info__title {
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		margin: 0;
		line-height: 1.1;
	}

	.info__lead {
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin: -1rem 0 0;
	}

	.info-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.info-block__heading {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.info-block__address {
		font-style: normal;
		font-size: 0.9375rem;
		color: var(--color-text);
		line-height: 1.75;
	}

	.info-block__list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.info-block__list li {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		font-size: 0.9375rem;
	}

	.info-block__icon {
		font-size: 1rem;
		flex-shrink: 0;
	}

	.info-block__link {
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}

	.info-block__link:hover {
		color: var(--color-accent);
	}

	.info-block__text {
		color: var(--color-text);
		font-weight: 500;
	}

	/* PRAWA KOLUMNA */
	.form-col {
		background-color: var(--color-white);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(15, 31, 61, 0.08);
	}

	.form-col__heading {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 1.5rem;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form__group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.form__group label {
		font-weight: 500;
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.form__group input,
	.form__group textarea {
		border: 1.5px solid #d1d5db;
		border-radius: var(--radius-md);
		padding: 0.75rem 1rem;
		font-size: 1rem;
		font-family: var(--font-sans);
		color: var(--color-text);
		background-color: var(--color-white);
		transition: border-color 0.15s;
		width: 100%;
	}

	.form__group input:focus,
	.form__group textarea:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px rgba(45, 126, 248, 0.15);
	}

	.form__group textarea {
		resize: vertical;
		min-height: 140px;
	}

	.btn {
		display: inline-block;
		padding: 0.875rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
	}

	.btn:hover { opacity: 0.88; }

	.btn--accent {
		background-color: var(--color-accent);
		color: var(--color-white);
	}

	.btn--full {
		width: 100%;
		text-align: center;
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.nav__hamburger { display: none; }

		.nav__menu {
			display: flex;
			flex-direction: row;
			position: static;
			box-shadow: none;
			padding: 0;
			gap: 2.5rem;
		}

		.nav__menu a {
			padding: 0;
			border-bottom: none;
			font-size: 0.9375rem;
		}

		.nav__menu a:hover { color: var(--color-accent); }

		.kontakt-grid {
			grid-template-columns: 1fr 1.5fr;
			gap: 4rem;
			align-items: start;
		}

		.btn--full {
			width: auto;
		}
	}
</style>
