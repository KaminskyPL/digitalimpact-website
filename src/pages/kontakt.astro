---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
	title="Kontakt – Digital Impact"
	description="Skontaktuj się z Digital Impact. Telefon, email, formularz kontaktowy i dane firmy."
>
	<Nav current="kontakt" />

	<!-- KONTAKT -->
	<section class="kontakt-section">
		<div class="container">
			<div class="kontakt-grid">

				<!-- LEWA KOLUMNA -->
				<div class="info-col">
					<h1 class="info__title">Kontakt</h1>
					<p class="info__lead">Napisz, zadzwoń lub wypełnij formularz – odezwę się w ciągu 24 godzin.</p>

					<div class="info-block">
						<h2 class="info-block__heading">Dane firmy</h2>
						<address class="info-block__address">
							Digital Impact Kamil Kiersnowski<br>
							ul. Sowlańska 42/22<br>
							15-560 Białystok<br>
							<br>
							NIP: 5432071736<br>
							REGON: 200661540
						</address>
					</div>

					<div class="info-block">
						<h2 class="info-block__heading">Kontakt bezpośredni</h2>
						<ul class="info-block__list">
							<li>
								<span class="info-block__icon">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/>
									</svg>
								</span>
								<a href="tel:+48696480318" class="info-block__link">+48 696 480 318 <span class="info-block__hours">(pn.–pt. 9:00–17:00)</span></a>
							</li>
							<li>
								<span class="info-block__icon">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<rect width="20" height="16" x="2" y="4" rx="2"/>
										<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
									</svg>
								</span>
								<span id="email-wrap"></span>
							</li>
						</ul>
					</div>
				</div>

				<!-- PRAWA KOLUMNA -->
				<div class="form-col">
					<h2 class="form-col__heading">Napisz do mnie</h2>
					<form class="form" id="contact-form" name="kontakt" action="https://formspree.io/f/xdajlkrp" method="POST">
						<input type="hidden" name="_language" value="pl" />
						<div class="form__group">
							<label for="imie">Imię</label>
							<input type="text" id="imie" name="imie" required placeholder="Twoje imię" autocomplete="name" />
						</div>
						<div class="form__group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required placeholder="twoj@email.pl" autocomplete="email" />
						</div>
						<div class="form__group">
							<label for="wiadomosc">Wiadomość</label>
							<textarea
								id="wiadomosc"
								name="wiadomosc"
								rows="6"
								required
								placeholder="Opowiedz mi o swojej firmie i wyzwaniach..."></textarea>
						</div>
						<button type="submit" class="btn btn--accent btn--full">Wyślij wiadomość</button>
					</form>
					<p id="form-success" style="display:none; color: var(--color-accent); margin-top: 1rem; font-weight: 500;">
						Dziękuję! Odezwę się w ciągu 24 godzin.
					</p>
				</div>

			</div>
		</div>
	</section>
</Layout>

<script>
	// Email obfuscation
	const u = 'kontakt';
	const d = 'digitalimpact.pl';
	const el = document.getElementById('email-wrap');
	if (el) el.innerHTML = '<a href="mailto:' + u + '@' + d + '" class="info-block__link" style="text-decoration:none;">' + u + '@' + d + '</a>';
	var emailLink = el.querySelector('a');
	if (emailLink) {
		var root = document.documentElement;
		var colorText = getComputedStyle(root).getPropertyValue('--color-text').trim();
		var colorAccent = getComputedStyle(root).getPropertyValue('--color-accent').trim();
		emailLink.style.color = colorText;
		emailLink.style.fontWeight = '500';
		emailLink.addEventListener('mouseenter', function() { this.style.color = colorAccent; });
		emailLink.addEventListener('mouseleave', function() { this.style.color = colorText; });
	}

	// Form submission
	const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
	const formSuccess = document.querySelector<HTMLElement>('#form-success');

	contactForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const submitBtn = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');

		if (submitBtn) {
			submitBtn.textContent = 'Wysyłanie...';
			submitBtn.disabled = true;
			submitBtn.style.opacity = '0.7';
		}

		const data = new FormData(contactForm);
		try {
			const res = await fetch(contactForm.action, {
				method: 'POST',
				body: data,
				headers: { Accept: 'application/json' },
			});
			if (res.ok) {
				if (submitBtn) {
					submitBtn.textContent = 'Wyślij wiadomość';
					submitBtn.disabled = false;
					submitBtn.style.opacity = '1';
				}
				contactForm.style.display = 'none';
				if (formSuccess) formSuccess.style.display = 'block';
			} else {
				if (submitBtn) {
					submitBtn.textContent = 'Wyślij wiadomość';
					submitBtn.disabled = false;
					submitBtn.style.opacity = '1';
				}
				alert('Coś poszło nie tak. Spróbuj napisać bezpośrednio na: kontakt@digitalimpact.pl');
			}
		} catch {
			if (submitBtn) {
				submitBtn.textContent = 'Wyślij wiadomość';
				submitBtn.disabled = false;
				submitBtn.style.opacity = '1';
			}
			alert('Coś poszło nie tak. Spróbuj napisać bezpośrednio na: kontakt@digitalimpact.pl');
		}
	});
</script>

<style>
	/* KONTAKT SECTION */
	.kontakt-section {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
		min-height: calc(100vh - 64px);
	}

	.kontakt-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* LEWA KOLUMNA */
	.info-col {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.info__title {
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		margin: 0;
		line-height: 1.1;
	}

	.info__lead {
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin: -1rem 0 0;
	}

	.info-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.info-block__heading {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.info-block__address {
		font-style: normal;
		font-size: 0.9375rem;
		color: var(--color-text);
		line-height: 1.75;
	}

	.info-block__list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.info-block__list li {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		font-size: 0.9375rem;
	}

	.info-block__icon {
		flex-shrink: 0;
		color: var(--color-accent);
		display: flex;
		align-items: center;
	}

	.info-block__link {
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}

	.info-block__link:hover {
		color: var(--color-accent);
	}

	.info-block__hours {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		font-weight: 400;
	}

	.info-block__text {
		color: var(--color-text);
		font-weight: 500;
	}

	/* PRAWA KOLUMNA */
	.form-col {
		background-color: var(--color-white);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(15, 31, 61, 0.08);
	}

	.form-col__heading {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 1.5rem;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form__group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.form__group label {
		font-weight: 500;
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.form__group input,
	.form__group textarea {
		border: 1.5px solid rgba(15, 31, 61, 0.15);
		border-radius: var(--radius-md);
		padding: 0.75rem 1rem;
		font-size: 1rem;
		font-family: var(--font-sans);
		color: var(--color-text);
		background-color: var(--color-white);
		transition: border-color 0.15s;
		width: 100%;
	}

	.form__group input:focus,
	.form__group textarea:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px rgba(45, 126, 248, 0.15);
	}

	.form__group textarea {
		resize: vertical;
		min-height: 140px;
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.kontakt-grid {
			grid-template-columns: 1fr 1.5fr;
			gap: 4rem;
			align-items: start;
		}
	}
</style>
