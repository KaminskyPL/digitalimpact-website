---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
	title="Kalkulator ROI z AI – Digital Impact"
	description="Sprawdź ile Twoja firma może zaoszczędzić dzięki AI. Darmowy kalkulator ROI – wynik w 2 minuty."
>
	<Nav current="" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<p class="hero__overline">bezpłatne narzędzie</p>
			<h1 class="hero__title">Kalkulator ROI z AI</h1>
			<p class="hero__subtitle">Sprawdź ile czasu i pieniędzy możesz zaoszczędzić automatyzując jeden proces w firmie. Wynik w 2 minuty.</p>
		</div>
	</section>

	<!-- KALKULATOR -->
	<section class="calc-section">
		<div class="container">
			<div class="calc-wrap">

				<!-- PROGRESS -->
				<div class="progress" role="group" aria-label="Postęp kalkulatora">
					<div class="progress__item">
						<div class="progress__circle active" id="prog-1">1</div>
						<span class="progress__label">Proces</span>
					</div>
					<div class="progress__line" id="line-1"></div>
					<div class="progress__item">
						<div class="progress__circle" id="prog-2">2</div>
						<span class="progress__label">Dane</span>
					</div>
					<div class="progress__line" id="line-2"></div>
					<div class="progress__item">
						<div class="progress__circle" id="prog-3">3</div>
						<span class="progress__label">Wynik</span>
					</div>
				</div>

				<!-- KROK 1 -->
				<div class="step" id="step-1">
					<h2 class="step__title">Który proces chcesz zautomatyzować?</h2>
					<div class="tiles">
						<button class="tile" data-process="obsługa" data-savings="0.60" type="button">
							<span class="tile__icon">💬</span>
							<span class="tile__label">Obsługa klienta / helpdesk</span>
							<span class="tile__savings">oszczędność do 60%</span>
						</button>
						<button class="tile" data-process="dokumenty" data-savings="0.70" type="button">
							<span class="tile__icon">📄</span>
							<span class="tile__label">Generowanie dokumentów / ofert</span>
							<span class="tile__savings">oszczędność do 70%</span>
						</button>
						<button class="tile" data-process="analiza" data-savings="0.55" type="button">
							<span class="tile__icon">📊</span>
							<span class="tile__label">Analiza danych / raportowanie</span>
							<span class="tile__savings">oszczędność do 55%</span>
						</button>
						<button class="tile" data-process="hr" data-savings="0.50" type="button">
							<span class="tile__icon">👥</span>
							<span class="tile__label">HR / onboarding</span>
							<span class="tile__savings">oszczędność do 50%</span>
						</button>
						<button class="tile" data-process="sprzedaz" data-savings="0.40" type="button">
							<span class="tile__icon">🎯</span>
							<span class="tile__label">Sprzedaż / lead generation</span>
							<span class="tile__savings">oszczędność do 40%</span>
						</button>
					</div>
					<div class="step__footer">
						<button type="button" class="btn btn--accent" id="next-1" disabled>Dalej →</button>
					</div>
				</div>

				<!-- KROK 2 -->
				<div class="step hidden" id="step-2">
					<h2 class="step__title">Kilka liczb o Twoim procesie</h2>

					<div class="sliders">
						<div class="slider-group">
							<div class="slider-group__header">
								<label class="slider-group__label" for="slider-people">Ile osób wykonuje ten proces?</label>
								<span class="slider-group__value"><span id="val-people">5</span> os.</span>
							</div>
							<input type="range" id="slider-people" min="1" max="50" value="5" step="1">
							<div class="slider-group__range">
								<span>1</span><span>50</span>
							</div>
						</div>

						<div class="slider-group">
							<div class="slider-group__header">
								<label class="slider-group__label" for="slider-hours">Ile godzin tygodniowo każda osoba poświęca na ten proces?</label>
								<span class="slider-group__value"><span id="val-hours">8</span> godz.</span>
							</div>
							<input type="range" id="slider-hours" min="1" max="40" value="8" step="1">
							<div class="slider-group__range">
								<span>1</span><span>40</span>
							</div>
						</div>

						<div class="slider-group">
							<div class="slider-group__header">
								<label class="slider-group__label" for="slider-rate">Średnia stawka godzinowa tych osób</label>
								<span class="slider-group__value"><span id="val-rate">80</span> PLN</span>
							</div>
							<input type="range" id="slider-rate" min="50" max="300" value="80" step="10">
							<div class="slider-group__range">
								<span>50 PLN</span><span>300 PLN</span>
							</div>
						</div>
					</div>

					<div class="step__footer step__footer--split">
						<button class="btn btn--outline" id="back-2" type="button">← Wróć</button>
						<button class="btn btn--accent" id="next-2" type="button">Oblicz →</button>
					</div>
				</div>

				<!-- KROK 3 – WYNIK -->
				<div class="step hidden" id="step-3">
					<h2 class="step__title">Twój szacunkowy potencjał oszczędności</h2>
					<p class="step__process-name">Proces: <strong id="result-process-name"></strong></p>

					<div class="results" aria-live="polite" aria-atomic="true">
						<div class="result-card result-card--neutral">
							<span class="result-card__label">Koszt procesu rocznie (bez AI)</span>
							<span class="result-card__value" id="result-cost">–</span>
						</div>
						<div class="result-card result-card--accent">
							<span class="result-card__label">Szacowana oszczędność z AI</span>
							<span class="result-card__value">
								<span id="result-savings">–</span>
								<span class="result-card__sub" id="result-percent"></span>
							</span>
						</div>
						<div class="result-card result-card--neutral">
							<span class="result-card__label">Szacowany zwrot z inwestycji</span>
							<span class="result-card__value result-card__value--sm">zwykle 3–6 miesięcy</span>
						</div>
					</div>

					<div class="result-cta">
						<h3 class="result-cta__title">Chcesz zobaczyć jak to wygląda w Twojej firmie?</h3>
						<p class="result-cta__sub">Umów bezpłatną konsultację – przeanalizuję z Tobą realny scenariusz dla Twoich procesów.</p>
						<a href="/kontakt" class="btn btn--accent btn--lg">Umów bezpłatną konsultację</a>
					</div>

					<p class="result-disclaimer">To szacunek orientacyjny. Dokładną analizę przeprowadzę podczas bezpłatnej konsultacji.</p>

					<div class="step__footer">
						<button class="btn btn--outline" id="back-3" type="button">← Przelicz ponownie</button>
					</div>
				</div>

			</div>
		</div>
	</section>

<script>
	// Calculator state
	let selectedSavings = 0;
	let selectedProcessLabel = '';

	// Step navigation
	function goToStep(n: number) {
		[1, 2, 3].forEach((i) => {
			const stepEl = document.getElementById(`step-${i}`);
			const progEl = document.getElementById(`prog-${i}`);
			const lineEl = i < 3 ? document.getElementById(`line-${i}`) : null;
			if (!stepEl || !progEl) return;
			stepEl.classList.toggle('hidden', i !== n);
			progEl.classList.remove('active', 'done');
			if (i === n) progEl.classList.add('active');
			if (i < n) progEl.classList.add('done');
			if (lineEl) lineEl.classList.toggle('done', i < n);
		});
		document.querySelector('.calc-wrap')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	// Slider fill update
	function updateSliderFill(slider: HTMLInputElement) {
		const min = parseFloat(slider.min);
		const max = parseFloat(slider.max);
		const val = parseFloat(slider.value);
		const pct = ((val - min) / (max - min)) * 100;
		slider.style.background = `linear-gradient(to right, var(--color-accent) ${pct}%, var(--color-accent-light) ${pct}%)`;
	}

	// Init sliders
	(['people', 'hours', 'rate'] as const).forEach((name) => {
		const slider = document.getElementById(`slider-${name}`) as HTMLInputElement;
		const display = document.getElementById(`val-${name}`);
		if (!slider || !display) return;
		updateSliderFill(slider);
		slider.addEventListener('input', () => {
			display.textContent = slider.value;
			updateSliderFill(slider);
		});
	});

	// Tile selection
	document.querySelectorAll<HTMLButtonElement>('.tile').forEach((tile) => {
		tile.addEventListener('click', () => {
			document.querySelectorAll('.tile').forEach((t) => t.classList.remove('selected'));
			tile.classList.add('selected');
			selectedSavings = parseFloat(tile.dataset.savings ?? '0');
			selectedProcessLabel = tile.querySelector('.tile__label')?.textContent ?? '';
			(document.getElementById('next-1') as HTMLButtonElement).disabled = false;
		});
	});

	// Button wiring
	document.getElementById('next-1')?.addEventListener('click', () => goToStep(2));
	document.getElementById('back-2')?.addEventListener('click', () => goToStep(1));
	document.getElementById('next-2')?.addEventListener('click', () => {
		calculate();
		goToStep(3);
	});
	document.getElementById('back-3')?.addEventListener('click', () => {
		goToStep(1);
		document.querySelectorAll('.tile').forEach((t) => t.classList.remove('selected'));
		(document.getElementById('next-1') as HTMLButtonElement).disabled = true;
	});

	// Calculation
	function calculate() {
		const people = parseInt((document.getElementById('slider-people') as HTMLInputElement).value);
		const hours = parseInt((document.getElementById('slider-hours') as HTMLInputElement).value);
		const rate = parseInt((document.getElementById('slider-rate') as HTMLInputElement).value);

		const annualCost = people * hours * 52 * rate;
		const annualSavings = Math.round(annualCost * selectedSavings);
		const pct = Math.round(selectedSavings * 100);

		const fmt = (n: number) =>
			new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 }).format(n);

		const el = (id: string) => document.getElementById(id);
		const costEl = el('result-cost');
		const savingsEl = el('result-savings');
		const percentEl = el('result-percent');
		const processEl = el('result-process-name');

		if (costEl) costEl.textContent = fmt(annualCost);
		if (savingsEl) savingsEl.textContent = fmt(annualSavings);
		if (percentEl) percentEl.textContent = `(${pct}% czasu)`;
		if (processEl) processEl.textContent = selectedProcessLabel;
	}
</script>
</Layout>

<style>
	/* HERO */
	.hero {
		background-color: var(--color-primary);
		padding: 4rem 1.5rem;
		text-align: center;
	}
	.hero__overline {
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
		color: var(--color-accent-light);
		font-weight: 600;
		text-transform: uppercase;
		margin: 0 0 1rem;
	}
	.hero__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: var(--color-white);
		margin: 0 0 1rem;
		line-height: 1.15;
	}
	.hero__subtitle {
		font-size: clamp(1rem, 2.5vw, 1.1875rem);
		color: var(--color-accent-light);
		max-width: 580px;
		margin-inline: auto;
		line-height: 1.65;
	}

	/* CALCULATOR */
	.calc-section {
		background-color: var(--color-surface);
		padding: 3rem 1.5rem 5rem;
	}
	.calc-wrap {
		max-width: 720px;
		margin-inline: auto;
	}

	/* PROGRESS */
	.progress {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 2.5rem;
		gap: 0;
	}
	.progress__item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
	}
	.progress__circle {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background-color: var(--color-accent-light);
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.2s, color 0.2s;
	}
	.progress__circle.active {
		background-color: var(--color-accent);
		color: var(--color-white);
	}
	.progress__circle.done {
		background-color: var(--color-primary);
		color: var(--color-white);
	}
	.progress__label {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		font-weight: 500;
	}
	.progress__line {
		flex: 1;
		height: 2px;
		background-color: var(--color-accent-light);
		margin: 0 0.5rem;
		margin-bottom: 1.25rem;
		max-width: 80px;
		transition: background-color 0.2s;
	}
	.progress__line.done {
		background-color: var(--color-primary);
	}

	/* STEPS */
	.step { animation: fadeIn 0.2s ease; }
	.step.hidden { display: none; }

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(6px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.step__title {
		font-size: clamp(1.25rem, 3vw, 1.625rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 1.75rem;
		line-height: 1.3;
	}
	.step__footer {
		margin-top: 2rem;
		display: flex;
		justify-content: flex-end;
	}
	.step__footer--split {
		justify-content: space-between;
	}

	/* TILES */
	.tiles {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.875rem;
	}
	.tile {
		display: flex;
		align-items: center;
		gap: 1rem;
		background-color: var(--color-white);
		border: 2px solid rgba(15, 31, 61, 0.1);
		border-radius: var(--radius-lg);
		padding: 1.125rem 1.25rem;
		cursor: pointer;
		text-align: left;
		transition: border-color 0.15s, box-shadow 0.15s;
		font-family: var(--font-sans);
	}
	.tile:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-sm);
	}
	.tile.selected {
		border-color: var(--color-accent);
		background-color: var(--color-accent-light);
		box-shadow: 0 0 0 3px rgba(45, 126, 248, 0.15);
	}
	.tile__icon {
		font-size: 1.75rem;
		flex-shrink: 0;
		line-height: 1;
	}
	.tile__label {
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-primary);
		flex: 1;
	}
	.tile__savings {
		font-size: 0.8125rem;
		color: var(--color-accent);
		font-weight: 500;
		white-space: nowrap;
	}

	/* SLIDERS */
	.sliders {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.slider-group__header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.slider-group__label {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-primary);
		line-height: 1.4;
	}
	.slider-group__value {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-accent);
		white-space: nowrap;
		flex-shrink: 0;
	}
	.slider-group__range {
		display: flex;
		justify-content: space-between;
		margin-top: 0.375rem;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	input[type="range"] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 4px;
		border-radius: 2px;
		background: var(--color-accent-light);
		outline: none;
		cursor: pointer;
	}
	input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-accent);
		cursor: pointer;
		box-shadow: 0 1px 4px rgba(45, 126, 248, 0.4);
		transition: box-shadow 0.15s;
	}
	input[type="range"]::-webkit-slider-thumb:hover {
		box-shadow: 0 1px 8px rgba(45, 126, 248, 0.6);
	}
	input[type="range"]::-moz-range-thumb {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-accent);
		cursor: pointer;
		border: none;
		box-shadow: 0 1px 4px rgba(45, 126, 248, 0.4);
	}

	/* RESULTS */
	.step__process-name {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		margin: -1rem 0 1.75rem;
	}
	.step__process-name strong {
		color: var(--color-primary);
	}
	.results {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.result-card {
		border-radius: var(--radius-lg);
		padding: 1.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.result-card--neutral {
		background-color: var(--color-white);
		border: 1px solid rgba(15, 31, 61, 0.08);
	}
	.result-card--accent {
		background-color: var(--color-accent);
		border: none;
	}
	.result-card__label {
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}
	.result-card--accent .result-card__label {
		color: rgba(255, 255, 255, 0.75);
	}
	.result-card__value {
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.2;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.result-card--accent .result-card__value {
		color: var(--color-white);
	}
	.result-card__value--sm {
		font-size: 1.25rem;
	}
	.result-card__sub {
		font-size: 1rem;
		font-weight: 500;
		opacity: 0.8;
	}

	/* RESULT CTA */
	.result-cta {
		background-color: var(--color-primary);
		border-radius: var(--radius-lg);
		padding: 2rem;
		text-align: center;
		margin-bottom: 1rem;
	}
	.result-cta__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-white);
		margin: 0 0 0.625rem;
		line-height: 1.35;
	}
	.result-cta__sub {
		font-size: 0.9375rem;
		color: var(--color-accent-light);
		margin: 0 0 1.5rem;
		line-height: 1.6;
	}
	.result-disclaimer {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		text-align: center;
		margin: 0 0 1.5rem;
	}

	/* BUTTONS */
	.btn {
		display: inline-block;
		padding: 0.75rem 1.75rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		transition: opacity 0.2s;
		border: none;
	}
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
	.btn--outline {
		background: transparent;
		border: 1.5px solid rgba(15, 31, 61, 0.25);
		color: var(--color-text);
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.tiles {
			grid-template-columns: repeat(2, 1fr);
		}
		.tiles .tile:last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}
	}
</style>
