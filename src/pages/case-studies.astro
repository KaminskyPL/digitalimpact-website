---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const caseStudies = allPosts.filter((p) => p.id.startsWith('case-study-'));
---

<Layout
	title="Case Studies – Digital Impact"
	description="Konkretne wdrożenia AI w firmach. Sprawdź realne efekty i oszczędności."
>
	<Nav current="case-studies" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<h1 class="hero__title">Case Studies</h1>
			<p class="hero__subtitle">Konkretne wdrożenia AI. Realne efekty.</p>
		</div>
	</section>

	<!-- LISTA CASE STUDIES -->
	<div class="studies">
		<div class="container">
			<div class="cards">
				{caseStudies.map((cs) => (
					<article class="card">
						<div class="card__meta">
							<span class="card__tag">{cs.data['branża']}</span>
						</div>
						<h2 class="card__title">
							<a href={`/case-studies/${cs.id}`}>{cs.data.title}</a>
						</h2>
						<p class="card__efekt">{cs.data.efekt}</p>
						<a href={`/case-studies/${cs.id}`} class="btn btn--accent">Czytaj więcej</a>
					</article>
				))}
			</div>
			<div class="cs-more">
				<p class="cs-more__text">Kolejne realizacje dostępne wkrótce – skontaktuj się, jeśli chcesz poznać szczegóły podobnych projektów.</p>
				<a href="/kontakt" class="cs-more__link">Napisz do mnie →</a>
			</div>
		</div>
	</div>
</Layout>


<style>
	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: var(--color-primary);
		margin: 0 0 1rem;
		line-height: 1.15;
	}

	.hero__subtitle {
		font-size: clamp(1.125rem, 2.5vw, 1.375rem);
		color: var(--color-text-muted);
		margin: 0;
		line-height: 1.5;
	}

	/* CARDS */
	.studies {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.card {
		border-top: 3px solid var(--color-accent);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.card__meta {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.card__tag {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
		background-color: rgba(45, 126, 248, 0.08);
		padding: 0.25rem 0.625rem;
		border-radius: 999px;
	}

	.card__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		line-height: 1.3;
		margin: 0;
	}

	.card__title a {
		color: inherit;
		text-decoration: none;
	}

	.card__title a:hover {
		color: var(--color-accent);
	}

	.card__efekt {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.6;
		margin: 0;
		flex: 1;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 0.9375rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
		align-self: flex-start;
	}

	.cs-more {
		margin-top: 2rem;
		text-align: center;
	}

	.cs-more__text {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.cs-more__link {
		display: inline-block;
		margin-top: 0.5rem;
		color: var(--color-accent);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
	.cs-more__link:hover {
		text-decoration: underline;
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.cards {
			grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
		}
	}
</style>
