---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const caseStudies = allPosts.filter((p) => p.id.startsWith('case-study-'));
	return caseStudies.map((cs) => ({
		params: { slug: cs.id },
		props: { entry: cs },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, klient, efekt, pubDate } = entry.data;
const branza = entry.data['branża'];
---

<Layout
	title={`${title} – Digital Impact`}
	description={efekt ?? entry.data.description ?? ''}
	ogType="article"
	ogDate={pubDate ? pubDate.toISOString() : undefined}
>
	<Nav current="case-studies" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<div class="hero__inner">
				<a href="/case-studies" class="back-link">← Case Studies</a>
				<h1 class="hero__title">{title}</h1>
			</div>
		</div>
	</section>

	<!-- META -->
	<div class="meta-section">
		<div class="container">
			<div class="meta-cards">
				{branza && (
					<div class="meta-card">
						<span class="meta-card__label">Branża</span>
						<span class="meta-card__value">{branza}</span>
					</div>
				)}
				{klient && (
					<div class="meta-card">
						<span class="meta-card__label">Klient</span>
						<span class="meta-card__value">{klient}</span>
					</div>
				)}
				{efekt && (
					<div class="meta-card meta-card--wide">
						<span class="meta-card__label">Efekt</span>
						<span class="meta-card__value">{efekt}</span>
					</div>
				)}
			</div>
		</div>
	</div>

	<!-- TREŚĆ -->
	<article class="content-section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Chcesz podobnych efektów w swojej firmie?</h2>
			<a href="/kontakt" class="btn btn--accent">Porozmawiajmy</a>
		</div>
	</section>
</Layout>

<style>
	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 3rem 1.5rem 2rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;
		margin-bottom: 1.25rem;
	}

	.back-link:hover {
		opacity: 0.8;
	}

	.hero__inner {
		max-width: 760px;
		margin-inline: auto;
	}

	.hero__title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.2;
		margin: 0;
	}

	/* META */
	.meta-section {
		background-color: var(--color-white);
		padding: 2rem 1.5rem;
		border-bottom: 1px solid rgba(15, 31, 61, 0.08);
	}

	.meta-cards {
		max-width: 760px;
		margin-inline: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta-card {
		border-left: 3px solid var(--color-accent);
		padding: 0.875rem 1.25rem;
		background-color: var(--color-surface);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 160px;
	}

	.meta-card--wide {
		flex: 1;
		min-width: 280px;
	}

	.meta-card__label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.meta-card__value {
		font-size: 0.9375rem;
		color: var(--color-text);
		line-height: 1.5;
		font-weight: 500;
	}

	/* CONTENT */
	.content-section {
		background-color: var(--color-white);
		padding: 3rem 1.5rem 4rem;
	}

	.prose {
		max-width: 760px;
		margin-inline: auto;
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.prose :global(h2) {
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 2.5rem 0 1rem;
		line-height: 1.25;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 1.75rem 0 0.75rem;
	}

	.prose :global(p) {
		margin: 0 0 1.25rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1.25rem;
	}

	.prose :global(li) {
		margin-bottom: 0.375rem;
	}

	.prose :global(strong) {
		font-weight: 700;
		color: var(--color-primary);
	}


</style>
