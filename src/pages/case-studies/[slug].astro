---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const caseStudies = allPosts.filter((p) => p.id.startsWith('case-study-'));
	return caseStudies.map((cs) => ({
		params: { slug: cs.id },
		props: { entry: cs },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, klient, efekt } = entry.data;
const branza = entry.data['branża'];
---

<Layout
	title={`${title} — Digital Impact`}
	description={efekt ?? entry.data.description ?? ''}
>
	<!-- NAWIGACJA -->
	<nav class="nav">
		<div class="nav__container">
			<a href="/" class="nav__logo"><img src="/logo.svg" alt="Digital Impact AI Consulting" height="44" style="display:block; height:44px; width:auto;"></a>
			<button class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<ul class="nav__menu" id="nav-menu" role="list">
				<li><a href="/#oferta">Oferta</a></li>
				<li><a href="/proces">Proces</a></li>
				<li><a href="/case-studies">Case Studies</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/o-mnie">O mnie</a></li>
				<li><a href="/kontakt">Kontakt</a></li>
			</ul>
		</div>
	</nav>

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<a href="/case-studies" class="back-link">← Case Studies</a>
			<h1 class="hero__title">{title}</h1>
		</div>
	</section>

	<!-- META -->
	<section class="meta-section">
		<div class="container">
			<div class="meta-cards">
				{branza && (
					<div class="meta-card">
						<span class="meta-card__label">Branża</span>
						<span class="meta-card__value">{branza}</span>
					</div>
				)}
				{klient && (
					<div class="meta-card">
						<span class="meta-card__label">Klient</span>
						<span class="meta-card__value">{klient}</span>
					</div>
				)}
				{efekt && (
					<div class="meta-card meta-card--wide">
						<span class="meta-card__label">Efekt</span>
						<span class="meta-card__value">{efekt}</span>
					</div>
				)}
			</div>
		</div>
	</section>

	<!-- TREŚĆ -->
	<article class="content-section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Chcesz podobnych efektów w swojej firmie?</h2>
			<a href="/kontakt" class="btn btn--accent">Porozmawiajmy</a>
		</div>
	</section>
</Layout>

<script>
	const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
	const menu = document.querySelector<HTMLUListElement>('.nav__menu');

	hamburger?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('nav__menu--open');
		hamburger.setAttribute('aria-expanded', String(isOpen));
	});

	document.querySelectorAll('.nav__menu a').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.remove('nav__menu--open');
			hamburger?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.container {
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* NAV */
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--color-white);
		box-shadow: var(--shadow-sm);
	}

	.nav__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin-inline: auto;
		padding: 0.75rem 1.5rem;
		min-height: 64px;
		position: relative;
	}

	.nav__logo {
		text-decoration: none;
		line-height: 0;
		padding: 0;
	}

	.nav__hamburger {
		display: flex;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.375rem;
	}

	.nav__hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-primary);
		border-radius: 2px;
	}

	.nav__menu {
		display: none;
		flex-direction: column;
		list-style: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background-color: var(--color-white);
		box-shadow: var(--shadow-md);
		padding: 0.5rem 1.25rem 1.25rem;
		margin: 0;
	}

	.nav__menu--open {
		display: flex;
	}

	.nav__menu a {
		display: block;
		padding: 0.75rem 0;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
		border-bottom: 1px solid var(--color-surface);
	}

	.nav__menu li:last-child a {
		border-bottom: none;
	}

	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 3rem 1.5rem 2rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;
		margin-bottom: 1.25rem;
	}

	.back-link:hover {
		opacity: 0.8;
	}

	.hero__title {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.2;
		margin: 0;
		max-width: 820px;
	}

	/* META */
	.meta-section {
		background-color: var(--color-white);
		padding: 2rem 1.5rem;
		border-bottom: 1px solid rgba(15, 31, 61, 0.08);
	}

	.meta-cards {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta-card {
		border-left: 3px solid var(--color-accent);
		padding: 0.875rem 1.25rem;
		background-color: var(--color-surface);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 160px;
	}

	.meta-card--wide {
		flex: 1;
		min-width: 280px;
	}

	.meta-card__label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.meta-card__value {
		font-size: 0.9375rem;
		color: var(--color-text);
		line-height: 1.5;
		font-weight: 500;
	}

	/* CONTENT */
	.content-section {
		background-color: var(--color-white);
		padding: 3rem 1.5rem 4rem;
	}

	.prose {
		max-width: 760px;
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--color-text);
	}

	.prose :global(h2) {
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 2.5rem 0 1rem;
		line-height: 1.25;
	}

	.prose :global(h3) {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 1.75rem 0 0.75rem;
	}

	.prose :global(p) {
		margin: 0 0 1.25rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5rem;
		margin: 0 0 1.25rem;
	}

	.prose :global(li) {
		margin-bottom: 0.375rem;
	}

	.prose :global(strong) {
		font-weight: 700;
		color: var(--color-primary);
	}

	/* CTA */
	.cta-section {
		background-color: var(--color-primary);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.cta-section__title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--color-white);
		max-width: 600px;
		margin-inline: auto;
		margin-bottom: 2rem;
		line-height: 1.3;
	}

	.btn {
		display: inline-block;
		padding: 0.875rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
	}

	.btn:hover {
		opacity: 0.88;
	}

	.btn--accent {
		background-color: var(--color-accent);
		color: var(--color-white);
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.nav__hamburger {
			display: none;
		}

		.nav__menu {
			display: flex;
			flex-direction: row;
			position: static;
			box-shadow: none;
			padding: 0;
			gap: 2.5rem;
		}

		.nav__menu a {
			padding: 0;
			border-bottom: none;
			font-size: 0.9375rem;
		}

		.nav__menu a:hover {
			color: var(--color-accent);
		}
	}
</style>
