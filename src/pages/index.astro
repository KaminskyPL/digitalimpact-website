---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Digital Impact – AI Consulting dla firm"
	description="Pomagamy firmom wdrażać AI i automatyzować procesy. Konkretnie, praktycznie, z mierzalnym efektem. Umów bezpłatną konsultację."
>
	<!-- NAWIGACJA -->
	<nav class="nav">
		<div class="nav__container">
			<a href="/" class="nav__logo"><img src="/logo.svg" alt="Digital Impact AI Consulting" height="44" style="display:block; height:44px; width:auto;"></a>
			<button class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<ul class="nav__menu" id="nav-menu" role="list">
				<li><a href="#oferta">Oferta</a></li>
				<li><a href="/proces">Proces</a></li>
				<li><a href="/ai-act">AI Act</a></li>
				<li><a href="/case-studies">Case Studies</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/o-mnie">O mnie</a></li>
				<li><a href="/kalkulator-roi">Kalkulator ROI</a></li>
				<li><a href="/kontakt">Kontakt</a></li>
			</ul>
		</div>
	</nav>

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<p class="hero__overline">ai consulting dla biznesu</p>
			<h1 class="hero__title">
				Wdrażamy AI w Twojej firmie.<br />
				Bez chaosu, z mierzalnym efektem.
			</h1>
			<p class="hero__subtitle">
				Pomagamy firmom automatyzować procesy i wykorzystywać AI – konkretnie, praktycznie, z wynikami.
			</p>
			<a href="/kontakt" class="btn btn--accent">Umów bezpłatną konsultację</a>
		</div>
	</section>

	<!-- METRICS -->
	<section class="metrics">
		<div class="container">
			<p class="metrics__label">W liczbach</p>
			<div class="metrics__grid">
				<div class="metrics__item">
					<span class="metrics__value">20+</span>
					<span class="metrics__desc">lat doświadczenia w IT i transformacji cyfrowej</span>
				</div>
				<div class="metrics__item">
					<span class="metrics__value">4–6</span>
					<span class="metrics__desc">tygodni do pierwszych mierzalnych efektów wdrożenia</span>
				</div>
				<div class="metrics__item">
					<span class="metrics__value">0 zł</span>
					<span class="metrics__desc">kosztów agencji zewnętrznej przy przebudowie stron klienta</span>
				</div>
				<div class="metrics__item">
					<span class="metrics__value">100%</span>
					<span class="metrics__desc">projektów realizowanych bez wysyłania danych firmowych do chmury</span>
				</div>
			</div>
		</div>
	</section>

	<!-- OFERTA -->
	<section class="oferta" id="oferta">
		<div class="container">
			<h2 class="section-title">Co robimy</h2>
			<div class="cards">
				<div class="card card--service">
					<span class="card__number">01</span>
					<h3 class="card__title">Audyt AI</h3>
					<p class="card__text card__text--muted">
						Analizujemy Twoje procesy i wskazujemy gdzie AI da największy zwrot
					</p>
				</div>
				<div class="card card--service">
					<span class="card__number">02</span>
					<h3 class="card__title">Wdrożenie</h3>
					<p class="card__text card__text--muted">
						Implementujemy konkretne narzędzia AI dopasowane do Twojej firmy
					</p>
				</div>
				<div class="card card--service">
					<span class="card__number">03</span>
					<h3 class="card__title">Szkolenie</h3>
					<p class="card__text card__text--muted">
						Uczymy Twój zespół jak korzystać z AI w codziennej pracy
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">
				Gotowy żeby sprawdzić co AI może zrobić dla Twojej firmy?
			</h2>
			<a href="/kontakt" class="btn btn--accent">Napisz do mnie</a>
		</div>
	</section>
</Layout>

<script>
	const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
	const menu = document.querySelector<HTMLUListElement>('.nav__menu');

	hamburger?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('nav__menu--open');
		hamburger.setAttribute('aria-expanded', String(isOpen));
	});

	document.querySelectorAll('.nav__menu a').forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.remove('nav__menu--open');
			hamburger?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	/* LAYOUT */
	.container {
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* BUTTONS */
	.btn {
		display: inline-block;
		padding: 0.875rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
	}
	.btn:hover {
		opacity: 0.88;
	}
	.btn--accent {
		background-color: var(--color-accent);
		color: var(--color-white);
	}

	/* SHARED */
	.section-title {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 700;
		color: var(--color-primary);
		text-align: center;
		margin-bottom: 2.5rem;
		line-height: 1.25;
	}

	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.card {
		background-color: var(--color-white);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(15, 31, 61, 0.08);
	}

	.card__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		margin-bottom: 0.75rem;
	}

	.card__text {
		font-size: 1.125rem;
		color: var(--color-text);
		line-height: 1.6;
		font-style: italic;
		margin: 0;
	}

	.card__text--muted {
		font-style: normal;
		color: var(--color-text-muted);
		font-size: 1rem;
	}

	.card__number {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	/* NAV */
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--color-white);
		box-shadow: var(--shadow-sm);
	}

	.nav__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin-inline: auto;
		padding: 0.75rem 1.5rem;
		min-height: 64px;
		position: relative;
	}

	.nav__logo {
		text-decoration: none;
		line-height: 0;
		padding: 0;
	}

	.nav__hamburger {
		display: flex;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.375rem;
	}

	.nav__hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-primary);
		border-radius: 2px;
	}

	.nav__menu {
		display: none;
		flex-direction: column;
		list-style: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background-color: var(--color-white);
		box-shadow: var(--shadow-md);
		padding: 0.5rem 1.25rem 1.25rem;
		margin: 0;
	}

	.nav__menu--open {
		display: flex;
	}

	.nav__menu a {
		display: block;
		padding: 0.75rem 0;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
		border-bottom: 1px solid var(--color-surface);
	}

	.nav__menu li:last-child a {
		border-bottom: none;
	}

	/* HERO */
	.hero {
		background-color: var(--color-primary);
		padding: 6rem 1.5rem;
		text-align: center;
	}

	.hero__overline {
		font-size: 0.875rem;
		letter-spacing: 0.1em;
		color: var(--color-accent-light);
		font-weight: 500;
		margin: 0 0 1.25rem;
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.15;
		color: var(--color-white);
		margin: 0 0 1.5rem;
	}

	.hero__subtitle {
		font-size: 1.125rem;
		color: var(--color-accent-light);
		max-width: 600px;
		margin-inline: auto;
		margin-bottom: 2.5rem;
		line-height: 1.7;
	}

	/* METRICS */
	.metrics {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.metrics__label {
		text-align: center;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin: 0 0 2.5rem;
	}

	.metrics__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		max-width: 860px;
		margin-inline: auto;
	}

	.metrics__item {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		background-color: var(--color-surface);
		border-radius: var(--radius-lg);
		border: 1px solid rgba(15, 31, 61, 0.07);
		padding: 1.75rem 1.25rem;
		gap: 0.5rem;
	}

	.metrics__value {
		font-size: clamp(2rem, 5vw, 2.5rem);
		font-weight: 800;
		color: var(--color-accent);
		line-height: 1;
	}

	.metrics__desc {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	/* OFERTA */
	.oferta {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.card--service {
		border-top: 3px solid var(--color-accent);
	}

	/* CTA SECTION */
	.cta-section {
		background-color: var(--color-primary);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.cta-section__title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--color-white);
		max-width: 640px;
		margin-inline: auto;
		margin-bottom: 2rem;
		line-height: 1.3;
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.nav__hamburger {
			display: none;
		}

		.nav__menu {
			display: flex;
			flex-direction: row;
			position: static;
			box-shadow: none;
			padding: 0;
			gap: 2.5rem;
		}

		.nav__menu a {
			padding: 0;
			border-bottom: none;
			font-size: 0.9375rem;
		}

		.nav__menu a:hover {
			color: var(--color-accent);
		}

		.cards {
			grid-template-columns: repeat(3, 1fr);
		}

		.metrics__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
