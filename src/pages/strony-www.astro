---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
	title="Projektowanie stron WWW – Digital Impact"
	description="Projektuję nowoczesne strony WWW zoptymalizowane pod Lighthouse 100/100 i SEO. Astro, czyste CSS, zero zbędnego JS. Od briefu do gotowej strony."
	breadcrumb={[{ name: 'Strony WWW', url: 'https://digitalimpact.pl/strony-www' }]}
>
	<Nav current="strony-www" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<p class="hero__overline">projektowanie stron www</p>
			<h1 class="hero__title">
				Strona, która robi robotę.<br />
				Szybka, widoczna w Google, bez kompromisów.
			</h1>
			<p class="hero__subtitle">
				Projektuję od zera – bez gotowych szablonów. Każda strona jest napisana
				ręcznie w Astro, zoptymalizowana pod Lighthouse 100/100 i dostosowana
				do Twoich celów biznesowych.
			</p>
			<div class="hero__actions">
				<a href="/kontakt" class="btn btn--accent">Omów projekt</a>
				<a href="#proces-www" class="btn btn--ghost">Zobacz jak pracuję</a>
			</div>
			<div class="hero__proof">
				<span class="hero__proof-item">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
					Lighthouse 100 / 100 / 100 / 100
				</span>
				<span class="hero__proof-item">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
					FCP 0.2s, LCP 0.3s, CLS 0
				</span>
				<span class="hero__proof-item">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
					Zero zewnętrznych zależności
				</span>
			</div>
		</div>
	</section>

	<!-- METRYKI -->
	<section class="www-metrics">
		<div class="container">
			<div class="www-metrics__grid">
				<div class="www-metrics__item">
					<p class="www-metrics__value">100 / 100</p>
					<p class="www-metrics__desc">Lighthouse Performance + SEO na tej stronie</p>
				</div>
				<div class="www-metrics__item">
					<p class="www-metrics__value">0.2s FCP</p>
					<p class="www-metrics__desc">First Contentful Paint – treść pojawia się błyskawicznie</p>
				</div>
				<div class="www-metrics__item">
					<p class="www-metrics__value">0 ms TBT</p>
					<p class="www-metrics__desc">Total Blocking Time – strona nigdy nie blokuje użytkownika</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CO DOSTAJESZ -->
	<section class="www-dostaniesz">
		<div class="container">
			<h2 class="section-title">Co wchodzi w zakres</h2>
			<p class="www-dostaniesz__lead">Nie szablon kupiony w marketplace. Kod pisany od zera, dostosowany do Twojej firmy.</p>
			<div class="www-steps">

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">01</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Własny kod, nie szablon</h3>
						<p class="www-step__desc">Każda strona powstaje od zera w Astro – czystym frameworku generującym statyczny HTML. Zero zbędnych wtyczek, zero ukrytych zależności. Kod, który rozumiesz i możesz rozwijać.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">02</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">SEO gotowe od pierwszej linii</h3>
						<p class="www-step__desc">Meta tagi, OpenGraph, Schema.org JSON-LD, sitemap, robots.txt – wszystko skonfigurowane poprawnie już w dniu wdrożenia. Nie czekasz miesiącami na indeksację.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">03</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Wydajność mierzona, nie deklarowana</h3>
						<p class="www-step__desc">Dostajesz zrzut Lighthouse z wynikami 100/100 do każdego projektu. FCP poniżej 0.3s, zero layout shift – bo optymalizacja jest wbudowana w proces, nie doklejana na końcu.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">04</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Tryb ciemny w standardzie</h3>
						<p class="www-step__desc">Ciemny motyw to nie opcja premium – buduję go od początku, razem z jasnym. Przełącznik wykrywa preferencje systemowe i zapamiętuje wybór użytkownika.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">05</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Mobile-first bez kompromisów</h3>
						<p class="www-step__desc">Projektuję od najmniejszego ekranu wzwyż. Każdy touch target ma minimum 44×44px. Żadnych elementów, które na telefonie się „jakoś" mieszczą.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">06</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Nagłówki bezpieczeństwa w standardzie</h3>
						<p class="www-step__desc">HSTS, CSP, X-Frame-Options, Referrer-Policy – skrojone pod konkretne zasoby strony, nie skopiowane z generatora. Cloudflare Pages jako hosting z automatycznym SSL.</p>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- PROCES PRACY -->
	<section class="www-proces" id="proces-www">
		<div class="container">
			<h2 class="section-title">Jak wygląda nasza współpraca</h2>
			<p class="www-proces__lead">Od pierwszej rozmowy do wdrożenia – żadnych niespodzianek w połowie drogi.</p>
			<div class="www-steps">

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">01</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Rozmowa i brief</h3>
						<p class="www-step__desc">Zaczynamy od 30-minutowej rozmowy. Pytam o cel strony, odbiorców, konkurencję i to, co Cię irytuje w obecnej witrynie. Na tej podstawie przygotuję brief – dokument, który opisuje zakres projektu i którego trzymamy się przez całą współpracę.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">02</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Projekt i wizualizacja</h3>
						<p class="www-step__desc">Przygotowuję propozycję layoutu – strukturę sekcji, hierarchię treści, paletę kolorów. Pokazuję Ci wersję desktop i mobile. Komentujesz, wprowadzam poprawki. Zaczynamy kodować dopiero gdy layout jest zaakceptowany.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">03</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Kodowanie i optymalizacja</h3>
						<p class="www-step__desc">Piszę kod w Astro – czysto, bez zbędnych zależności. Na bieżąco mierzę Lighthouse i poprawiam każde odchylenie od 100. SEO, dostępność, bezpieczeństwo – to nie finalna lista kontrolna, tylko część procesu.</p>
					</div>
				</div>

				<div class="www-step">
					<div class="www-step__left">
						<div class="www-step__num">04</div>
					</div>
					<div class="www-step__content">
						<h3 class="www-step__title">Prezentacja i wdrożenie</h3>
						<p class="www-step__desc">Przed wdrożeniem pokazuję Ci gotową stronę na środowisku testowym. Dostajesz czas na ostatnie uwagi. Po akceptacji – wdrożenie na Twojej domenie, konfiguracja DNS i SSL, przekazanie dostępów. Dostajesz też zrzut Lighthouse jako potwierdzenie jakości.</p>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- AI BRIDGE -->
	<section class="www-ai-bridge" id="www-ai">
		<div class="container">
			<h2 class="www-ai-bridge__title">Strona to narzędzie. AI robi z niej maszynę.</h2>
			<p class="www-ai-bridge__lead">Każda strona, którą buduję, jest gotowa na integrację z AI. Kalkulator ROI, chatbot obsługi klienta, automatyczne generowanie ofert – to nie science-fiction, to gotowe integracje, które możesz uruchomić od razu po wdrożeniu strony.</p>
			<div class="www-ai-bridge__cards">
				<div class="www-ai-bridge__card">
					<span class="www-ai-bridge__tag">Audyt AI</span>
					<h3 class="www-ai-bridge__card-title">Sprawdź, co AI może zautomatyzować w Twojej firmie</h3>
					<a href="/kalkulator-roi" class="www-ai-bridge__card-link">
						Oblicz ROI
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
				<div class="www-ai-bridge__card">
					<span class="www-ai-bridge__tag">Wdrożenie AI</span>
					<h3 class="www-ai-bridge__card-title">Gotowy integrować AI z Twoją nową stroną?</h3>
					<a href="/kontakt" class="www-ai-bridge__card-link">
						Porozmawiajmy
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="www-faq">
		<div class="container">
			<h2 class="section-title">Najczęstsze pytania</h2>
			<div class="faq-index__grid">

				<details class="faq-index__item">
					<summary class="faq-index__question">
						Na jakiej technologii budujesz strony?
						<svg class="faq-index__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
					</summary>
					<p class="faq-index__answer">Pracuję wyłącznie na Astro – frameworku, który generuje czysty, statyczny HTML. Zero zbędnego JavaScriptu wysyłanego do przeglądarki. To bezpośredni powód, dla którego wyniki Lighthouse są takie, jakie są – nie dlatego, że "dbam o wydajność", ale dlatego, że architektura na to pozwala.</p>
				</details>

				<details class="faq-index__item">
					<summary class="faq-index__question">
						Czy mogę samodzielnie edytować treści?
						<svg class="faq-index__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
					</summary>
					<p class="faq-index__answer">Tak. Standardowo strona trafia na Twoje repozytorium GitHub, a treści możesz edytować jako pliki Markdown – bez dotykania kodu. Jeśli potrzebujesz CMS z interfejsem wizualnym, mogę dołączyć Decap CMS (bezpłatny, open-source). Kwestię omawiamy na briefie.</p>
				</details>

				<details class="faq-index__item">
					<summary class="faq-index__question">
						Czy wdrożenie u Ciebie oznacza, że nie skontaktuję się z hostem, rejestratorem domeny itd.?
						<svg class="faq-index__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
					</summary>
					<p class="faq-index__answer">W standardzie konfiguruję wszystko sam – Cloudflare Pages jako hosting, DNS, SSL, nagłówki bezpieczeństwa. Potrzebuję tylko dostępu do panelu Twojego rejestratora domeny (np. OVH, home.pl, nazwa.pl) na czas konfiguracji. Resztą zajmuję się ja.</p>
				</details>

				<details class="faq-index__item">
					<summary class="faq-index__question">
						Jak to się łączy z AI consulting?
						<svg class="faq-index__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
					</summary>
					<p class="faq-index__answer">Strona WWW to fundament – bez niej AI nie ma gdzie "wylądować". Formularz kontaktowy, który obsługuje chatbot, kalkulator oparty na modelu językowym, automatyczne odpowiedzi – to wszystko wymaga dobrze zbudowanej strony jako bazy. Dlatego oferuję to jako kompletny pakiet: strona + AI, nie jedno albo drugie.</p>
				</details>

			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Porozmawiajmy o Twojej stronie.</h2>
			<p class="www-cta__lead">30-minutowa rozmowa wystarczy, żeby ocenić zakres i oszacować czas realizacji.</p>
			<a href="/kontakt" class="btn btn--accent">Napisz do mnie</a>
		</div>
	</section>

	<!-- JSON-LD -->
	<script type="application/ld+json" is:inline>{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Service",
		"name": "Projektowanie stron WWW",
		"provider": {
			"@type": "LocalBusiness",
			"@id": "https://digitalimpact.pl/#business",
			"name": "Digital Impact Kamil Kiersnowski"
		},
		"serviceType": "Web Design",
		"description": "Projektowanie nowoczesnych stron WWW w Astro, zoptymalizowanych pod Lighthouse 100/100 i SEO.",
		"areaServed": "PL",
		"url": "https://digitalimpact.pl/strony-www"
	})}</script>

</Layout>

<style>
	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 6rem 1.5rem;
		text-align: center;
	}

	.hero__overline {
		font-size: 0.875rem;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		font-weight: 500;
		margin: 0 0 1.25rem;
		text-transform: uppercase;
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.15;
		color: var(--color-primary);
		margin: 0 0 1.5rem;
	}

	.hero__subtitle {
		font-size: 1.125rem;
		color: var(--color-text-muted);
		max-width: 600px;
		margin-inline: auto;
		margin-bottom: 2.5rem;
		line-height: 1.7;
	}

	.hero__actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.btn--ghost {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		border-radius: var(--radius-md);
		padding: 0.75rem 1.5rem;
		background: transparent;
		border: 2px solid var(--color-primary);
		color: var(--color-primary);
		transition: background-color 0.15s, color 0.15s, border-color 0.15s;
	}

	.btn--ghost:hover {
		background-color: var(--color-primary);
		color: #FFFFFF;
		border-color: var(--color-primary);
	}

	.hero__proof {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: center;
	}

	.hero__proof-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.hero__proof-item svg {
		color: currentColor;
		flex-shrink: 0;
	}

	/* WWW-METRICS */
	.www-metrics {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.www-metrics__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.www-metrics__item {
		background-color: var(--color-white);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(15, 31, 61, 0.08);
		text-align: center;
	}

	.www-metrics__value {
		font-size: clamp(2.25rem, 5vw, 2.75rem);
		font-weight: 800;
		color: var(--color-primary);
		margin: 0 0 0.5rem;
		line-height: 1;
	}

	.www-metrics__desc {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.5;
		margin: 0;
	}

	/* WWW-DOSTANIESZ */
	.www-dostaniesz {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
	}

	.www-dostaniesz__lead {
		text-align: center;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		max-width: 560px;
		margin-inline: auto;
		margin-top: -1.5rem;
		margin-bottom: 2.5rem;
		line-height: 1.6;
	}

	.www-steps {
		position: relative;
		max-width: 780px;
		margin-inline: auto;
	}

	.www-steps::before {
		content: '';
		position: absolute;
		top: 56px;
		bottom: 56px;
		left: 27px;
		width: 2px;
		background-color: var(--color-accent-light);
	}

	.www-step {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 1.5rem;
		padding: 0 0 2.5rem;
	}

	.www-step:last-child { padding-bottom: 0; }

	.www-step__left {
		display: flex;
		justify-content: center;
		padding-top: 2px;
		position: relative;
		z-index: 1;
	}

	.www-step__num {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background-color: var(--color-accent-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		font-weight: 800;
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.www-step__content {
		padding-top: 0.875rem;
	}

	.www-step__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 0.5rem;
	}

	.www-step__desc {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin: 0;
	}

	/* WWW-PROCES */
	.www-proces {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.www-proces__lead {
		text-align: center;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		max-width: 560px;
		margin-inline: auto;
		margin-top: -1.5rem;
		margin-bottom: 3rem;
		line-height: 1.6;
	}

	/* WWW-AI-BRIDGE */
	.www-ai-bridge {
		background-color: #0F1F3D;
		padding: 5rem 1.5rem;
	}

	.www-ai-bridge__title {
		font-size: clamp(1.5rem, 3.5vw, 2.25rem);
		font-weight: 800;
		color: #FFFFFF;
		text-align: center;
		margin-bottom: 1rem;
	}

	.www-ai-bridge__lead {
		font-size: 1.0625rem;
		color: rgba(232, 241, 255, 0.8);
		max-width: 580px;
		margin-inline: auto;
		text-align: center;
		margin-bottom: 2.5rem;
		line-height: 1.65;
	}

	.www-ai-bridge__cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		max-width: 800px;
		margin-inline: auto;
	}

	.www-ai-bridge__card {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(232, 241, 255, 0.12);
		border-radius: var(--radius-lg);
		padding: 2rem;
	}

	.www-ai-bridge__tag {
		display: inline-block;
		background: rgba(91, 158, 250, 0.2);
		color: #5B9EFA;
		font-size: 0.8125rem;
		font-weight: 600;
		border-radius: 999px;
		padding: 0.25rem 0.75rem;
		margin-bottom: 1rem;
	}

	.www-ai-bridge__card-title {
		font-size: 1.125rem;
