---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
	title="Kamil Kiersnowski – AI Consultant | Digital Impact"
	description="Ponad 20 lat w IT, od 2024 roku specjalizuję się we wdrożeniach AI dla firm. Poznaj moje doświadczenie i podejście do pracy."
	breadcrumb={[{name: "O mnie", url: "https://digitalimpact.pl/o-mnie"}]}
>
	<Nav current="o-mnie" />

	<!-- HERO -->
	<section class="hero">
		<div class="container">
			<h1 class="hero__name">Kamil Kiersnowski</h1>
			<p class="hero__tagline">Pomagam firmom przestać się bać AI – i zacząć na nim zarabiać.</p>
			<p class="hero__lead">
				Ponad 20 lat w IT, 15 lat komercyjnie. Od 2024 roku robię jedno: przekładam potencjał sztucznej
				inteligencji na konkretne procesy i wyniki w firmach.
			</p>
		</div>
	</section>

	<!-- SKĄD TO WIEM -->
	<section class="about">
		<div class="container">
			<div class="about__grid">
				<div class="about__text">
					<h2 class="section-title about__heading">Nie sprzedaję AI. Wdrażam je.</h2>
					<p class="about__p">
						Zanim zacząłem pomagać innym firmom, sam byłem po drugiej stronie – jako AI Ambassador
						w dużej polskiej spółce dystrybucyjnej odpowiadałem za wdrożenia AI w codziennych
						procesach: od automatyzacji systemów CMS, przez analizę zgodności produktowej z
						regulacjami EU, po budowanie wewnętrznych narzędzi opartych na modelach językowych.
					</p>
					<p class="about__p">
						To praktyczne doświadczenie – nie teoria z kursu – jest podstawą tego, co oferuję
						klientom.
					</p>
				</div>
				<div class="about__stats">
					<div class="stat">
						<span class="stat__value">ponad 20 lat</span>
						<span class="stat__label">doświadczenia w IT</span>
					</div>
					<div class="stat">
						<span class="stat__value">15 lat</span>
						<span class="stat__label">komercyjnie</span>
					</div>
					<div class="stat">
						<span class="stat__value">od 2011</span>
						<span class="stat__label">własna działalność</span>
					</div>
					<div class="stat">
						<span class="stat__value">AI w praktyce</span>
						<span class="stat__label">nie w teorii</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CO KONKRETNIE ROBIĘ -->
	<section class="services">
		<div class="container">
			<h2 class="section-title">Z czym przychodzą do mnie klienci</h2>
			<div class="cards">
				<div class="card card--service">
					<span class="card__number">01</span>
					<h3 class="card__title">Automatyzacja procesów</h3>
					<p class="card__text">
						Identyfikujemy powtarzalne zadania w Twojej firmie i zastępujemy je narzędziami AI –
						od obsługi dokumentów po komunikację z klientami.
					</p>
				</div>
				<div class="card card--service">
					<span class="card__number">02</span>
					<h3 class="card__title">Wdrożenie narzędzi AI</h3>
					<p class="card__text">
						Dobieram i wdrażam konkretne rozwiązania: modele językowe, asystentów, systemy baz
						wiedzy – dopasowane do Twojego stacku technologicznego.
					</p>
				</div>
				<div class="card card--service">
					<span class="card__number">03</span>
					<h3 class="card__title">Szkolenia dla zespołów</h3>
					<p class="card__text">
						Uczymy ludzi, nie tylko systemy. Warsztaty dla zespołów z realnego używania AI w
						codziennej pracy.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section">
		<div class="container">
			<h2 class="cta-section__title">Chcesz sprawdzić czy AI ma sens w Twojej firmie?</h2>
			<a href="/kontakt" class="btn btn--accent">Porozmawiajmy</a>
		</div>
	</section>
</Layout>


<style>
	.card--service {
		border-top: 3px solid var(--color-accent);
	}

	.card__number {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.card__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-primary);
		margin-bottom: 0.75rem;
	}

	.card__text {
		font-size: 1rem;
		color: var(--color-text-muted);
		line-height: 1.6;
		margin: 0;
	}

	/* HERO */
	.hero {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
	}

	.hero__name {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1.1;
		margin: 0 0 1rem;
	}

	.hero__tagline {
		font-size: clamp(1.125rem, 2.5vw, 1.375rem);
		font-weight: 600;
		color: var(--color-accent);
		margin: 0 0 1.25rem;
		line-height: 1.4;
	}

	.hero__lead {
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		max-width: 640px;
		line-height: 1.7;
		margin: 0;
	}

	/* SKĄD TO WIEM */
	.about {
		background-color: var(--color-white);
		padding: 4rem 1.5rem;
	}

	.about__heading {
		text-align: left;
	}

	.about__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}

	.about__p {
		font-size: 1rem;
		color: var(--color-text);
		line-height: 1.75;
		margin-bottom: 1rem;
	}

	.about__p:last-child {
		margin-bottom: 0;
	}

	.about__stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.stat {
		border-left: 3px solid var(--color-accent);
		padding: 1.5rem;
		background-color: var(--color-surface);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
	}

	.stat__value {
		display: block;
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--color-primary);
		line-height: 1.2;
		margin-bottom: 0.375rem;
	}

	.stat__label {
		display: block;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	/* CO ROBIĘ */
	.services {
		background-color: var(--color-surface);
		padding: 4rem 1.5rem;
	}

	/* DESKTOP */
	@media (min-width: 768px) {
		.about__grid {
			grid-template-columns: 3fr 2fr;
			align-items: start;
		}
	}
</style>
