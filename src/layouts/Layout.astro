---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
	ogDate?: string;
}

const { title, description = '', ogImage, ogType = 'website', ogDate } = Astro.props;
const ogImageUrl = ogImage ?? 'https://digitalimpact.pl/og-image.jpg';
---

<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="theme-color" content="#0F1F3D" />
	<meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />
		<script is:inline>
			(function() {
				var stored = localStorage.getItem('di-theme');
				var theme;
				if (stored) {
					theme = stored;
				} else {
					theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				if (theme === 'dark') {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preload" href="/fonts/dm-sans-latin-ext-500-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-ext-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-ext-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-ext-800-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />
		<link rel="alternate" type="application/rss+xml" title="Digital Impact – Blog o AI dla firm" href="https://digitalimpact.pl/rss.xml" />

		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content="Digital Impact" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		{ogDate && <meta property="article:published_time" content={ogDate} />}
		{ogDate && <meta property="article:author" content="Kamil Kiersnowski" />}
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": ["LocalBusiness", "ProfessionalService"],
			"name": "Digital Impact",
			"legalName": "Digital Impact Kamil Kiersnowski",
			"description": "Konsulting AI dla firm – wdrożenia sztucznej inteligencji, automatyzacja procesów, szkolenia zespołów.",
			"url": "https://digitalimpact.pl",
			"logo": "https://digitalimpact.pl/logo.svg",
			"image": "https://digitalimpact.pl/og-image.jpg",
			"telephone": "+48696480318",
			"email": "kontakt@digitalimpact.pl",
			"founder": {
				"@type": "Person",
				"name": "Kamil Kiersnowski",
				"jobTitle": "AI Consultant",
				"url": "https://digitalimpact.pl/o-mnie"
			},
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "ul. Sowlańska 42/22",
				"addressLocality": "Białystok",
				"postalCode": "15-560",
				"addressCountry": "PL"
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
					"opens": "09:00",
					"closes": "17:00"
				}
			],
			"areaServed": {
				"@type": "Country",
				"name": "PL"
			},
			"priceRange": "$$",
			"knowsAbout": ["Artificial Intelligence", "Machine Learning", "Business Automation", "AI Act compliance"],
			"sameAs": [
				"https://github.com/KaminskyPL",
				"https://www.linkedin.com/in/kamilkiersnowski/"
			]
		}
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link" tabindex="0">Przejdź do treści</a>
		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer" aria-label="Stopka strony">
			<div class="site-footer__inner">
				<div class="site-footer__brand">
					<img src="/logo.svg" alt="Digital Impact AI Consulting" width="132" height="36" style="display:block; height:36px; width:auto; filter: brightness(0) invert(1); opacity: 0.85;">
					<p class="site-footer__tagline">AI Consulting dla firm.<br>Konkretnie, praktycznie, z wynikami.</p>
					<p class="site-footer__since">Działam od 2011 roku</p>
					<a
						href="https://www.linkedin.com/in/kamilkiersnowski/"
						class="site-footer__linkedin"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Profil LinkedIn Kamila Kiersnowskiego"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						LinkedIn
					</a>
				</div>
				<nav class="site-footer__nav" aria-label="Nawigacja stopka">
					<span class="site-footer__nav-heading">Strony</span>
					<a href="/proces" class="site-footer__link">Proces współpracy</a>
					<a href="/ai-act" class="site-footer__link">AI Act</a>
					<a href="/case-studies" class="site-footer__link">Case Studies</a>
					<a href="/blog" class="site-footer__link">Blog</a>
					<a href="/o-mnie" class="site-footer__link">O mnie</a>
					<a href="/kalkulator-roi" class="site-footer__link">Kalkulator ROI</a>
				</nav>
				<div class="site-footer__contact">
					<span class="site-footer__nav-heading">Kontakt</span>
					<span class="site-footer__contact-item">Digital Impact Kamil Kiersnowski</span>
					<span class="site-footer__contact-item">ul. Sowlańska 42/22, 15-560 Białystok</span>
					<span class="site-footer__contact-item"><span style="unicode-bidi:plaintext">NIP:&nbsp;5432071736</span></span>
					<div class="site-footer__contact-row">
						<svg class="site-footer__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/>
						</svg>
						<span class="site-footer__phone-block">
							<a href="tel:+48696480318" class="site-footer__phone-link">+48 696 480 318</a>
							<span class="site-footer__hours">(pn.–pt. 9:00–17:00)</span>
						</span>
					</div>
					<span id="footer-email-wrap" class="site-footer__link site-footer__contact-row"></span>
				</div>
			</div>
			<div class="site-footer__bottom">
				<span class="site-footer__copy">© 2026 Digital Impact Kamil Kiersnowski</span>
				<div class="site-footer__bottom-links">
					<a href="/polityka-prywatnosci" class="site-footer__link">Polityka prywatności</a>
					<button type="button" id="cookie-settings-btn" class="site-footer__cookie-btn">Ustawienia cookies</button>
				</div>
			</div>
		</footer>

		<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Zgoda na pliki cookie" aria-modal="false" style="display:none;">
			<div class="cookie-banner__inner">
				<p class="cookie-banner__text">
					Używamy cookies do analizy ruchu (Google Analytics). Możesz zaakceptować wszystkie lub tylko niezbędne.
					<a href="/polityka-prywatnosci" class="cookie-banner__policy-link">Polityka prywatności</a>
				</p>
				<div class="cookie-banner__btns">
					<button type="button" id="cookie-accept-all" class="cookie-btn cookie-btn--accept">Akceptuję wszystkie</button>
					<button type="button" id="cookie-necessary-only" class="cookie-btn cookie-btn--necessary">Tylko niezbędne</button>
				</div>
			</div>
		</div>
	</body>
</html>

<script is:inline>
	function loadGoogleAnalytics() {
		if (window._gaLoaded) return;
		window._gaLoaded = true;
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6YT8138L6';
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function() { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', 'G-P6YT8138L6');
	}

	var consent = localStorage.getItem('cookie_consent');
	var banner = document.getElementById('cookie-banner');

	if (consent === 'all') {
		loadGoogleAnalytics();
	} else if (!consent) {
		banner.style.display = 'block';
	}

	document.getElementById('cookie-accept-all').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'all');
		banner.style.display = 'none';
		loadGoogleAnalytics();
	});

	document.getElementById('cookie-necessary-only').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'necessary');
		banner.style.display = 'none';
	});

	var settingsBtn = document.getElementById('cookie-settings-btn');
	if (settingsBtn) {
		settingsBtn.addEventListener('click', function() {
			localStorage.removeItem('cookie_consent');
			location.reload();
		});
	}

	var emailWrap = document.getElementById('footer-email-wrap');
	if (emailWrap) {
		var u = 'kontakt'; var d = 'digitalimpact.pl';
		emailWrap.innerHTML = '<a href="mailto:' + u + '@' + d + '" class="site-footer__link site-footer__contact-row" style="text-decoration:none;color:inherit;"><svg class="site-footer__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>' + u + '@' + d + '</a>';
	}
</script>

<style is:global>

	/* =============================================
	   SHARED UTILITIES — używane na wielu stronach
	   ============================================= */

	/* Layout */
	.container {
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* Buttons */
	.btn {
		display: inline-block;
		padding: 0.875rem 2rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 1rem;
		font-family: var(--font-sans);
		text-decoration: none;
		cursor: pointer;
		border: none;
		transition: opacity 0.2s;
	}

	.btn:hover {
		opacity: 0.88;
	}

	.btn--accent {
		background-color: var(--color-accent);
		color: var(--color-white);
	}

	.btn--outline {
		background-color: transparent;
		color: var(--color-primary);
		border: 1.5px solid var(--color-primary);
	}

	.btn--full {
		width: 100%;
		text-align: center;
	}

	.btn--lg {
		padding: 1rem 2.5rem;
		font-size: 1.0625rem;
	}

	/* Section title */
	.section-title {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 700;
		color: var(--color-primary);
		text-align: center;
		margin-bottom: 2.5rem;
		line-height: 1.25;
	}

	/* Back link — używany na stronach blogowych i case studies */
	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--color-accent);
		text-decoration: none;
		font-weight: 500;
		margin-bottom: 1.25rem;
	}

	.back-link:hover {
		opacity: 0.8;
	}

	/* Card base */
	.card {
		background-color: var(--color-white);
		border-radius: var(--radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(15, 31, 61, 0.08);
	}

	/* Cards grid */
	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	@media (min-width: 768px) {
		.cards {
			grid-template-columns: repeat(3, 1fr);
		}

		.btn--full {
			width: auto;
		}
	}

	/* CTA section */
	.cta-section {
		background-color: var(--color-primary);
		padding: 4rem 1.5rem;
		text-align: center;
	}

	.cta-section__title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--color-white);
		max-width: 640px;
		margin-inline: auto;
		margin-bottom: 2rem;
		line-height: 1.3;
	}

	/* FOOTER */
	.site-footer {
		background-color: #0F1F3D;
		padding: 3rem 1.5rem 0;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: 1100px;
		margin-inline: auto;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.site-footer__tagline {
		font-size: 0.9375rem;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.6;
		margin-top: 0.875rem;
	}

	.site-footer__since {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.55);
		margin: 0.25rem 0 0;
	}

	.site-footer__linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0.5rem 0.875rem;
		background-color: rgba(232, 241, 255, 0.08);
		border: 1px solid rgba(232, 241, 255, 0.15);
		border-radius: var(--radius-md);
		color: rgba(232, 241, 255, 0.75);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s, border-color 0.15s;
	}

	.site-footer__linkedin:hover {
		background-color: rgba(45, 126, 248, 0.25);
		border-color: var(--color-accent);
		color: #FFFFFF;
	}

	.site-footer__nav,
	.site-footer__contact {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.site-footer__nav-heading {
		font-size: 0.75rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.55);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.375rem;
	}

	.site-footer__contact-item {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.5;
	}

	.site-footer__link {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.site-footer__link:hover {
		color: #FFFFFF;
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		max-width: 1100px;
		margin-inline: auto;
		padding: 1.25rem 0;
	}

	.site-footer__copy {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.55);
	}

	.site-footer__bottom-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-footer__cookie-btn {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.7);
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		font-family: var(--font-sans);
	}

	.site-footer__cookie-btn:hover {
		color: #FFFFFF;
	}

	.site-footer__contact-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.site-footer__icon {
		flex-shrink: 0;
		color: rgba(255, 255, 255, 0.6);
	}

	.site-footer__hours {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.55);
		margin-left: 0.2rem;
		white-space: nowrap;
		pointer-events: none;
	}

	.site-footer__link:hover .site-footer__hours {
		opacity: 0.7;
		color: rgba(255, 255, 255, 0.7);
	}

	.site-footer__phone-block {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.site-footer__phone-link {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-footer__phone-link:hover {
		color: #FFFFFF;
	}


	@media (min-width: 768px) {
		.site-footer__inner {
			grid-template-columns: 2fr 1fr 1.5fr;
			gap: 3rem;
		}
	}

	/* COOKIE BANNER */
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background-color: var(--color-primary);
		color: var(--color-white);
		z-index: 999;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.cookie-banner__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin-inline: auto;
		padding: 1rem 1.5rem;
	}

	.cookie-banner__text {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		flex: 1;
		min-width: 260px;
	}

	.cookie-banner__policy-link {
		color: var(--color-accent-light);
		margin-left: 0.375rem;
	}

	.cookie-banner__btns {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
		flex-wrap: wrap;
	}

	.cookie-btn {
		padding: 0.625rem 1.25rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 600;
		font-family: var(--font-sans);
		cursor: pointer;
		white-space: nowrap;
		transition: opacity 0.2s;
	}

	.cookie-btn:hover {
		opacity: 0.88;
	}

	.cookie-btn--accept {
		background-color: var(--color-accent);
		color: var(--color-white);
		border: none;
	}

	.cookie-btn--necessary {
		background-color: transparent;
		color: var(--color-white);
		border: 1.5px solid rgba(255, 255, 255, 0.6);
	}

	/* Focus visible — dostępność klawiaturowa */
	:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}

	:focus:not(:focus-visible) {
		outline: none;
	}

	/* Skip to content — dostępność */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 1rem;
		background-color: var(--color-primary);
		color: var(--color-white);
		padding: 0.5rem 1rem;
		border-radius: 0 0 var(--radius-md) var(--radius-md);
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		z-index: 9999;
		transition: top 0.1s;
	}

	.skip-link:focus {
		top: 0;
	}

	[data-theme="dark"] .cta-section {
		background-color: #0a1628;
		border-top: 1px solid rgba(232, 241, 255, 0.1);
	}

	[data-theme="dark"] .cta-section__title {
		color: #E8F1FF;
	}

	[data-theme="dark"] .cta-section__sub {
		color: rgba(232, 241, 255, 0.75) !important;
	}

	[data-theme="dark"] .site-footer {
		background-color: #071020;
		border-top: 1px solid rgba(232, 241, 255, 0.08);
	}

	/* =============================================
	   Dark Mode — per-page overrides (is:global required for Astro scoping)
	   ============================================= */

	/* Buttons */
	[data-theme="dark"] .btn--accent {
		background-color: #2D7EF8 !important;
		color: #FFFFFF !important;
