---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description = '', ogImage } = Astro.props;
const ogImageUrl = ogImage ?? 'https://digitalimpact.pl/og-image.jpg';
---

<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<slot />

		<footer class="site-footer">
			<div class="site-footer__inner">
				<span class="site-footer__copy">© 2026 Digital Impact Kamil Kiersnowski</span>
				<nav class="site-footer__links">
					<a href="/polityka-prywatnosci" class="site-footer__link">Polityka prywatności</a>
					<button id="cookie-settings-btn" class="site-footer__cookie-btn">Ustawienia cookies</button>
				</nav>
			</div>
		</footer>

		<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Zgoda na cookies" style="display:none;">
			<div class="cookie-banner__inner">
				<p class="cookie-banner__text">
					Używamy cookies do analizy ruchu (Google Analytics). Możesz zaakceptować wszystkie lub tylko niezbędne.
					<a href="/polityka-prywatnosci" class="cookie-banner__policy-link">Polityka prywatności</a>
				</p>
				<div class="cookie-banner__btns">
					<button id="cookie-accept-all" class="cookie-btn cookie-btn--accept">Akceptuję wszystkie</button>
					<button id="cookie-necessary-only" class="cookie-btn cookie-btn--necessary">Tylko niezbędne</button>
				</div>
			</div>
		</div>
	</body>
</html>

<script is:inline>
	function loadGoogleAnalytics() {
		if (window._gaLoaded) return;
		window._gaLoaded = true;
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6YT8138L6';
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function() { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', 'G-P6YT8138L6');
	}

	var consent = localStorage.getItem('cookie_consent');
	var banner = document.getElementById('cookie-banner');

	if (consent === 'all') {
		loadGoogleAnalytics();
	} else if (!consent) {
		banner.style.display = 'block';
	}

	document.getElementById('cookie-accept-all').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'all');
		banner.style.display = 'none';
		loadGoogleAnalytics();
	});

	document.getElementById('cookie-necessary-only').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'necessary');
		banner.style.display = 'none';
	});

	var settingsBtn = document.getElementById('cookie-settings-btn');
	if (settingsBtn) {
		settingsBtn.addEventListener('click', function() {
			localStorage.removeItem('cookie_consent');
			location.reload();
		});
	}
</script>

<style is:global>
	body {
		font-family: var(--font-sans);
		color: var(--color-text);
		background-color: var(--color-white);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	/* FOOTER */
	.site-footer {
		background-color: var(--color-primary);
		padding: 1.25rem 1.5rem;
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		max-width: 1100px;
		margin-inline: auto;
	}

	.site-footer__copy {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.6);
	}

	.site-footer__links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-footer__link {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.site-footer__link:hover {
		color: var(--color-white);
	}

	.site-footer__cookie-btn {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.7);
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		font-family: var(--font-sans);
	}

	.site-footer__cookie-btn:hover {
		color: var(--color-white);
	}

	/* COOKIE BANNER */
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background-color: var(--color-primary);
		color: var(--color-white);
		z-index: 999;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.cookie-banner__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin-inline: auto;
		padding: 1rem 1.5rem;
	}

	.cookie-banner__text {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		flex: 1;
		min-width: 260px;
	}

	.cookie-banner__policy-link {
		color: var(--color-accent-light);
		margin-left: 0.375rem;
	}

	.cookie-banner__btns {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
		flex-wrap: wrap;
	}

	.cookie-btn {
		padding: 0.625rem 1.25rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 600;
		font-family: var(--font-sans);
		cursor: pointer;
		white-space: nowrap;
		transition: opacity 0.2s;
	}

	.cookie-btn:hover {
		opacity: 0.88;
	}

	.cookie-btn--accept {
		background-color: var(--color-accent);
		color: var(--color-white);
		border: none;
	}

	.cookie-btn--necessary {
		background-color: transparent;
		color: var(--color-white);
		border: 1.5px solid rgba(255, 255, 255, 0.6);
	}
</style>
