---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description = '', ogImage } = Astro.props;
const ogImageUrl = ogImage ?? 'https://digitalimpact.pl/og-image.jpg';
---

<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": ["LocalBusiness", "ProfessionalService"],
			"name": "Digital Impact",
			"legalName": "Digital Impact Kamil Kiersnowski",
			"description": "Konsulting AI dla firm – wdrożenia sztucznej inteligencji, automatyzacja procesów, szkolenia zespołów.",
			"url": "https://digitalimpact.pl",
			"logo": "https://digitalimpact.pl/logo.svg",
			"image": "https://digitalimpact.pl/og-image.jpg",
			"telephone": "+48696480318",
			"email": "kontakt@digitalimpact.pl",
			"founder": {
				"@type": "Person",
				"name": "Kamil Kiersnowski",
				"jobTitle": "AI Consultant",
				"url": "https://digitalimpact.pl/o-mnie"
			},
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "ul. Sowlańska 42/22",
				"addressLocality": "Białystok",
				"postalCode": "15-560",
				"addressCountry": "PL"
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
					"opens": "09:00",
					"closes": "17:00"
				}
			],
			"areaServed": {
				"@type": "Country",
				"name": "PL"
			},
			"priceRange": "$$",
			"knowsAbout": ["Artificial Intelligence", "Machine Learning", "Business Automation", "AI Act compliance"],
			"sameAs": []
		}
		</script>
	</head>
	<body>
		<slot />

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__brand">
					<img src="/logo.svg" alt="Digital Impact AI Consulting" height="36" style="display:block; height:36px; width:auto; filter: brightness(0) invert(1); opacity: 0.85;">
					<p class="site-footer__tagline">AI Consulting dla firm.<br>Konkretnie, praktycznie, z wynikami.</p>
				</div>
				<nav class="site-footer__nav" aria-label="Nawigacja stopka">
					<span class="site-footer__nav-heading">Strony</span>
					<a href="/proces" class="site-footer__link">Proces współpracy</a>
					<a href="/case-studies" class="site-footer__link">Case Studies</a>
					<a href="/blog" class="site-footer__link">Blog</a>
					<a href="/ai-act" class="site-footer__link">AI Act</a>
					<a href="/kalkulator-roi" class="site-footer__link">Kalkulator ROI</a>
				</nav>
				<div class="site-footer__contact">
					<span class="site-footer__nav-heading">Kontakt</span>
					<span class="site-footer__contact-item">Digital Impact Kamil Kiersnowski</span>
					<span class="site-footer__contact-item">ul. Sowlańska 42/22, 15-560 Białystok</span>
					<span class="site-footer__contact-item">NIP: 5432071736</span>
					<a href="tel:+48696480318" class="site-footer__link site-footer__contact-row">
						<svg class="site-footer__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.07 6.07l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/>
						</svg>
						+48 696 480 318 <span class="site-footer__hours">(pn.–pt. 9:00–17:00)</span>
					</a>
					<span id="footer-email-wrap" class="site-footer__link site-footer__contact-row"></span>
				</div>
			</div>
			<div class="site-footer__bottom">
				<span class="site-footer__copy">© 2026 Digital Impact Kamil Kiersnowski</span>
				<div class="site-footer__bottom-links">
					<a href="/polityka-prywatnosci" class="site-footer__link">Polityka prywatności</a>
					<button id="cookie-settings-btn" class="site-footer__cookie-btn">Ustawienia cookies</button>
				</div>
			</div>
		</footer>

		<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Zgoda na cookies" style="display:none;">
			<div class="cookie-banner__inner">
				<p class="cookie-banner__text">
					Używamy cookies do analizy ruchu (Google Analytics). Możesz zaakceptować wszystkie lub tylko niezbędne.
					<a href="/polityka-prywatnosci" class="cookie-banner__policy-link">Polityka prywatności</a>
				</p>
				<div class="cookie-banner__btns">
					<button id="cookie-accept-all" class="cookie-btn cookie-btn--accept">Akceptuję wszystkie</button>
					<button id="cookie-necessary-only" class="cookie-btn cookie-btn--necessary">Tylko niezbędne</button>
				</div>
			</div>
		</div>
	</body>
</html>

<script is:inline>
	function loadGoogleAnalytics() {
		if (window._gaLoaded) return;
		window._gaLoaded = true;
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6YT8138L6';
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function() { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', 'G-P6YT8138L6');
	}

	var consent = localStorage.getItem('cookie_consent');
	var banner = document.getElementById('cookie-banner');

	if (consent === 'all') {
		loadGoogleAnalytics();
	} else if (!consent) {
		banner.style.display = 'block';
	}

	document.getElementById('cookie-accept-all').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'all');
		banner.style.display = 'none';
		loadGoogleAnalytics();
	});

	document.getElementById('cookie-necessary-only').addEventListener('click', function() {
		localStorage.setItem('cookie_consent', 'necessary');
		banner.style.display = 'none';
	});

	var settingsBtn = document.getElementById('cookie-settings-btn');
	if (settingsBtn) {
		settingsBtn.addEventListener('click', function() {
			localStorage.removeItem('cookie_consent');
			location.reload();
		});
	}

	var emailWrap = document.getElementById('footer-email-wrap');
	if (emailWrap) {
		var u = 'kontakt'; var d = 'digitalimpact.pl';
		emailWrap.innerHTML = '<a href="mailto:' + u + '@' + d + '" class="site-footer__link site-footer__contact-row" style="text-decoration:none;color:inherit;"><svg class="site-footer__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>' + u + '@' + d + '</a>';
	}
</script>

<style is:global>
	body {
		font-family: var(--font-sans);
		color: var(--color-text);
		background-color: var(--color-white);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	/* FOOTER */
	.site-footer {
		background-color: var(--color-primary);
		padding: 3rem 1.5rem 0;
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: 1100px;
		margin-inline: auto;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.site-footer__tagline {
		font-size: 0.9375rem;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.6;
		margin-top: 0.875rem;
	}

	.site-footer__nav,
	.site-footer__contact {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.site-footer__nav-heading {
		font-size: 0.75rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.375rem;
	}

	.site-footer__contact-item {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.5;
	}

	.site-footer__link {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.site-footer__link:hover {
		color: var(--color-white);
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		max-width: 1100px;
		margin-inline: auto;
		padding: 1.25rem 0;
	}

	.site-footer__copy {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.45);
	}

	.site-footer__bottom-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-footer__cookie-btn {
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.7);
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		font-family: var(--font-sans);
	}

	.site-footer__cookie-btn:hover {
		color: var(--color-white);
	}

	.site-footer__contact-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.site-footer__icon {
		flex-shrink: 0;
		opacity: 0.7;
	}

	.site-footer__hours {
		font-size: 0.75rem;
		opacity: 0.7;
		margin-left: 0.2rem;
	}

	@media (min-width: 768px) {
		.site-footer__inner {
			grid-template-columns: 2fr 1fr 1.5fr;
			gap: 3rem;
		}
	}

	/* COOKIE BANNER */
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background-color: var(--color-primary);
		color: var(--color-white);
		z-index: 999;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.cookie-banner__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin-inline: auto;
		padding: 1rem 1.5rem;
	}

	.cookie-banner__text {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		flex: 1;
		min-width: 260px;
	}

	.cookie-banner__policy-link {
		color: var(--color-accent-light);
		margin-left: 0.375rem;
	}

	.cookie-banner__btns {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
		flex-wrap: wrap;
	}

	.cookie-btn {
		padding: 0.625rem 1.25rem;
		border-radius: var(--radius-md);
		font-size: 0.875rem;
		font-weight: 600;
		font-family: var(--font-sans);
		cursor: pointer;
		white-space: nowrap;
		transition: opacity 0.2s;
	}

	.cookie-btn:hover {
		opacity: 0.88;
	}

	.cookie-btn--accept {
		background-color: var(--color-accent);
		color: var(--color-white);
		border: none;
	}

	.cookie-btn--necessary {
		background-color: transparent;
		color: var(--color-white);
		border: 1.5px solid rgba(255, 255, 255, 0.6);
	}
</style>
