---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="nav" aria-label="Nawigacja główna">
  <div class="nav__container">
    <a href="/" class="nav__logo">
      <img src="/logo.svg" alt="Digital Impact AI Consulting" width="160" height="44" class="nav__logo-img" fetchpriority="high">
    </a>

    <div class="nav__controls">
      <div class="nav__hint-wrap">
        <div id="theme-hint" class="nav__hint" role="tooltip" aria-live="polite" hidden>
          <div class="nav__hint-arrow" aria-hidden="true"></div>
          <button type="button" class="nav__hint-close" id="theme-hint-close" aria-label="Zamknij podpowiedź">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
          <p class="nav__hint-text" id="theme-hint-text"></p>
          <p class="nav__hint-sub">Kliknij żeby przełączyć.</p>
        </div>
        <button type="button" id="theme-toggle-mobile" class="nav__theme-toggle" aria-label="Przełącz tryb ciemny">
          <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>

      <button type="button" class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <ul class="nav__menu" id="nav-menu">
      <li><a href="/#oferta" class={current === 'oferta' ? 'nav__active' : ''} aria-current={current === 'oferta' ? 'page' : undefined}>Oferta</a></li>
      <li><a href="/proces" class={current === 'proces' ? 'nav__active' : ''} aria-current={current === 'proces' ? 'page' : undefined}>Proces</a></li>
      <li><a href="/ai-act" class={current === 'ai-act' ? 'nav__active' : ''} aria-current={current === 'ai-act' ? 'page' : undefined}>AI Act</a></li>
      <li><a href="/case-studies" class={current === 'case-studies' ? 'nav__active' : ''} aria-current={current === 'case-studies' ? 'page' : undefined}>Case Studies</a></li>
      <li><a href="/blog" class={current === 'blog' ? 'nav__active' : ''} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a></li>
      <li><a href="/o-mnie" class={current === 'o-mnie' ? 'nav__active' : ''} aria-current={current === 'o-mnie' ? 'page' : undefined}>O mnie</a></li>
      <li><a href="/kontakt" class={current === 'kontakt' ? 'nav__active' : ''} aria-current={current === 'kontakt' ? 'page' : undefined}>Kontakt</a></li>
      <li class="nav__theme-item">
        <div class="nav__hint-wrap">
          <div id="theme-hint-desktop" class="nav__hint" role="tooltip" aria-live="polite" hidden>
            <div class="nav__hint-arrow" aria-hidden="true"></div>
            <button type="button" class="nav__hint-close" id="theme-hint-close-desktop" aria-label="Zamknij podpowiedź">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
            <p class="nav__hint-text" id="theme-hint-text-desktop"></p>
            <p class="nav__hint-sub">Kliknij żeby przełączyć.</p>
          </div>
          <button type="button" id="theme-toggle-desktop" class="nav__theme-toggle" aria-label="Przełącz tryb ciemny">
            <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </li>
    </ul>
  </div>
</nav>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
  const menu = document.querySelector<HTMLUListElement>('.nav__menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('nav__menu--open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.nav__menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.remove('nav__menu--open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (e) => {
    if (!menu?.classList.contains('nav__menu--open')) return;
    const target = e.target as Node;
    if (!menu.contains(target) && !hamburger?.contains(target)) {
      menu.classList.remove('nav__menu--open');
      hamburger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle-mobile');
  const themeToggleDesktop = document.getElementById('theme-toggle-desktop');

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('di-theme', theme);
    updateToggleIcon(theme);
  }

  function updateToggleIcon(theme: string) {
    const html = document.documentElement;
    if (theme === 'dark') {
      html.classList.add('theme--dark');
    } else {
      html.classList.remove('theme--dark');
    }
  }

  function getCurrentTheme(): string {
    const stored = localStorage.getItem('di-theme');
    if (stored) return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  updateToggleIcon(getCurrentTheme());

  function onToggleClick() {
    const current = getCurrentTheme();
    applyTheme(current === 'dark' ? 'light' : 'dark');
  }

  themeToggle?.addEventListener('click', onToggleClick);
  themeToggleDesktop?.addEventListener('click', onToggleClick);

  // Theme hint — pokazuje się tylko przy pierwszej wizycie
  (function() {
    const HINT_KEY = 'di-hint-shown';
    if (localStorage.getItem(HINT_KEY)) return;

    // Wykryj który hint jest widoczny (desktop vs mobile)
    // Desktop: nav__controls ma display:none, menu jest widoczne
    // Mobile: nav__controls widoczny, menu schowane
    const isMobile = window.innerWidth < 900;

    const hintId = isMobile ? 'theme-hint' : 'theme-hint-desktop';
    const hintTextId = isMobile ? 'theme-hint-text' : 'theme-hint-text-desktop';
    const closeBtnId = isMobile ? 'theme-hint-close' : 'theme-hint-close-desktop';

    const hint = document.getElementById(hintId);
    const hintText = document.getElementById(hintTextId);
    const closeBtn = document.getElementById(closeBtnId);
    if (!hint || !hintText) return;

    const currentTheme = getCurrentTheme();
    hintText.textContent = currentTheme === 'dark'
      ? 'Wolisz wersję jasną?'
      : 'Wolisz wersję ciemną?';

    let hideTimer: ReturnType<typeof setTimeout>;

    function showHint() {
      hint!.hidden = false;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          hint!.classList.add('nav__hint--visible');
        });
      });
      hideTimer = setTimeout(hideHint, 5000);
    }

    function hideHint() {
      clearTimeout(hideTimer);
      hint!.classList.remove('nav__hint--visible');
      hint!.addEventListener('transitionend', () => {
        hint!.hidden = true;
      }, { once: true });
      localStorage.setItem(HINT_KEY, '1');
    }

    setTimeout(showHint, 1000);
    closeBtn?.addEventListener('click', hideHint);
    themeToggle?.addEventListener('click', hideHint, { once: true });
    themeToggleDesktop?.addEventListener('click', hideHint, { once: true });
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    border-bottom: 1px solid rgba(15, 31, 61, 0.08);
  }

  .nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin-inline: auto;
    padding: 0.75rem 1.5rem;
    min-height: 64px;
    position: relative;
  }

  @media (min-width: 900px) {
    .nav__container {
      padding: 0.75rem 2rem;
    }
  }

  .nav__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__logo-img {
    display: block;
    height: 36px;
    width: auto;
  }

  @media (min-width: 900px) {
    .nav__logo-img {
      height: 44px;
    }
  }

  /* CONTROLS: toggle + hamburger razem po prawej */
  .nav__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 900px) {
    .nav__controls {
      display: none;
    }
  }

  /* HAMBURGER */
  .nav__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 36px;
    height: 36px;
  }

  @media (min-width: 900px) {
    .nav__hamburger {
      display: none;
    }
  }

  .nav__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  html.theme--dark .nav__hamburger span {
    background-color: var(--color-text);
  }

  /* MENU */
  .nav__menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 899px) {
    .nav__menu--open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-white);
      box-shadow: 0 8px 24px rgba(15, 31, 61, 0.12);
      padding: 0.5rem 0 1rem;
      z-index: 99;
    }
  }

  @media (min-width: 900px) {
    .nav__menu {
      display: flex;
      flex-direction: row;
      align-items: center;
      position: static;
      box-shadow: none;
      padding: 0;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1100px) {
    .nav__menu {
      gap: 2rem;
    }
  }

  .nav__menu a {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.15s;
  }

  @media (max-width: 899px) {
    .nav__menu a {
      padding: 0.75rem 1.5rem;
      border-bottom: 1px solid rgba(15, 31, 61, 0.06);
      font-size: 1rem;
    }
  }

  @media (min-width: 900px) {
    .nav__menu a {
      padding: 0;
      border-bottom: none;
      font-size: 0.875rem;
      white-space: nowrap;
    }

    .nav__menu a:hover {
      color: var(--color-accent);
    }
  }

  @media (min-width: 1100px) {
    .nav__menu a {
      font-size: 0.9375rem;
    }
  }

  .nav__active {
    color: var(--color-accent) !important;
  }

  /* Desktop: toggle widoczny w menu jako ostatni element */
  .nav__theme-item {
    display: none;
  }

  @media (min-width: 900px) {
    .nav__theme-item {
      display: flex;
      align-items: center;
    }
  }

  /* HINT WRAP */
  .nav__hint-wrap {
    position: relative;
  }

  /* HINT DYMKA */
  .nav__hint {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: #FFFFFF;
    border: 1px solid rgba(15, 31, 61, 0.12);
    border-radius: 10px;
    padding: 10px 28px 10px 12px;
    width: 196px;
    z-index: 1000;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
  }

  .nav__hint:not([hidden]) {
    pointer-events: auto;
  }

  .nav__hint.nav__hint--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .nav__hint-arrow {
    position: absolute;
    top: -6px;
    right: 11px;
    width: 12px;
    height: 6px;
    background: #FFFFFF;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
    border-left: 1px solid rgba(15, 31, 61, 0.12);
    border-right: 1px solid rgba(15, 31, 61, 0.12);
  }

  .nav__hint-close {
    position: absolute;
    top: 7px;
    right: 8px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px;
    color: #9BA8BB;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .nav__hint-close:hover {
    color: #6B7280;
    background: rgba(15, 31, 61, 0.06);
  }

  .nav__hint-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #0F1F3D;
    margin: 0 0 3px;
    line-height: 1.3;
  }

  .nav__hint-sub {
    font-size: 0.75rem;
    color: #6B7280;
    margin: 0;
    line-height: 1.4;
  }

  /* THEME TOGGLE */
  .nav__theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: none;
    border: 1.5px solid rgba(15, 31, 61, 0.15);
    cursor: pointer;
    color: var(--color-text);
    transition: background-color 0.2s, border-color 0.2s;
    padding: 0;
    flex-shrink: 0;
  }

  .nav__theme-toggle:hover {
    background-color: var(--color-surface);
  }

  @media (min-width: 900px) {
    .nav__theme-toggle {
      border-color: rgba(15, 31, 61, 0.2);
    }
  }

  .theme-icon--moon { display: block; }
  .theme-icon--sun  { display: none;  }

  html.theme--dark .theme-icon--moon { display: none;  }
  html.theme--dark .theme-icon--sun  { display: block; }

  html.theme--dark .nav__logo-img {
    filter: brightness(0) invert(1);
  }

  html.theme--dark .nav__theme-toggle {
    border-color: rgba(232, 241, 255, 0.2);
    color: var(--color-text);
  }

  html.theme--dark .nav__hint {
    background: #1a2d4d;
    border-color: rgba(232, 241, 255, 0.15);
  }

  html.theme--dark .nav__hint-arrow {
    background: #1a2d4d;
    border-left-color: rgba(232, 241, 255, 0.15);
    border-right-color: rgba(232, 241, 255, 0.15);
  }

  html.theme--dark .nav__hint-text {
    color: #E8F1FF;
  }

  html.theme--dark .nav__hint-sub {
    color: #9BA8BB;
  }

  html.theme--dark .nav__hint-close {
    color: #9BA8BB;
  }

  html.theme--dark .nav__hint-close:hover {
    background: rgba(232, 241, 255, 0.08);
  }
</style>
