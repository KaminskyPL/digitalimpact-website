---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="nav">
  <div class="nav__container">
    <a href="/" class="nav__logo">
      <img src="/logo.svg" alt="Digital Impact AI Consulting" height="44" style="display:block; height:44px; width:auto;">
    </a>
    <button class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav__menu" id="nav-menu" role="list">
      <li><a href="/#oferta" class={current === 'oferta' ? 'nav__active' : ''}>Oferta</a></li>
      <li><a href="/proces" class={current === 'proces' ? 'nav__active' : ''}>Proces</a></li>
      <li><a href="/ai-act" class={current === 'ai-act' ? 'nav__active' : ''}>AI Act</a></li>
      <li><a href="/case-studies" class={current === 'case-studies' ? 'nav__active' : ''}>Case Studies</a></li>
      <li><a href="/blog" class={current === 'blog' ? 'nav__active' : ''}>Blog</a></li>
      <li><a href="/o-mnie" class={current === 'o-mnie' ? 'nav__active' : ''}>O mnie</a></li>
      <li><a href="/kontakt" class={current === 'kontakt' ? 'nav__active' : ''}>Kontakt</a></li>
    </ul>
  </div>
</nav>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
  const menu = document.querySelector<HTMLUListElement>('.nav__menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('nav__menu--open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.nav__menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.remove('nav__menu--open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin-inline: auto;
    padding: 0.75rem 1.5rem;
    min-height: 64px;
    position: relative;
  }

  .nav__logo {
    text-decoration: none;
    line-height: 0;
    padding: 0;
  }

  .nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
  }

  .nav__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  .nav__menu {
    display: none;
    flex-direction: column;
    list-style: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
    padding: 0.5rem 1.25rem 1.25rem;
    margin: 0;
  }

  .nav__menu--open {
    display: flex;
  }

  .nav__menu a {
    display: block;
    padding: 0.75rem 0;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--color-surface);
  }

  .nav__menu li:last-child a {
    border-bottom: none;
  }

  .nav__active {
    color: var(--color-accent) !important;
  }

  @media (min-width: 768px) {
    .nav__hamburger {
      display: none;
    }

    .nav__menu {
      display: flex;
      flex-direction: row;
      position: static;
      box-shadow: none;
      padding: 0;
      gap: 2rem;
    }

    .nav__menu a {
      padding: 0;
      border-bottom: none;
      font-size: 0.9375rem;
    }

    .nav__menu a:hover {
      color: var(--color-accent);
    }
  }
</style>
