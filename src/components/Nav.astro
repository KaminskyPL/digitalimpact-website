---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="nav" aria-label="Nawigacja główna">
  <div class="nav__container">
    <a href="/" class="nav__logo">
      <img src="/logo.svg" alt="Digital Impact AI Consulting" width="160" height="44" class="nav__logo-img" style="display:block; height:44px; width:auto;" fetchpriority="high">
    </a>
    <button type="button" class="nav__hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav__menu" id="nav-menu">
      <li><a href="/#oferta" class={current === 'oferta' ? 'nav__active' : ''} aria-current={current === 'oferta' ? 'page' : undefined}>Oferta</a></li>
      <li><a href="/proces" class={current === 'proces' ? 'nav__active' : ''} aria-current={current === 'proces' ? 'page' : undefined}>Proces</a></li>
      <li><a href="/ai-act" class={current === 'ai-act' ? 'nav__active' : ''} aria-current={current === 'ai-act' ? 'page' : undefined}>AI Act</a></li>
      <li><a href="/case-studies" class={current === 'case-studies' ? 'nav__active' : ''} aria-current={current === 'case-studies' ? 'page' : undefined}>Case Studies</a></li>
      <li><a href="/blog" class={current === 'blog' ? 'nav__active' : ''} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a></li>
      <li><a href="/o-mnie" class={current === 'o-mnie' ? 'nav__active' : ''} aria-current={current === 'o-mnie' ? 'page' : undefined}>O mnie</a></li>
      <li><a href="/kontakt" class={current === 'kontakt' ? 'nav__active' : ''} aria-current={current === 'kontakt' ? 'page' : undefined}>Kontakt</a></li>
      <li class="nav__theme-item">
        <button type="button" id="theme-toggle" class="nav__theme-toggle" aria-label="Przełącz tryb ciemny">
          <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </li>
    </ul>
  </div>
</nav>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.nav__hamburger');
  const menu = document.querySelector<HTMLUListElement>('.nav__menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('nav__menu--open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.nav__menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.remove('nav__menu--open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (e) => {
    if (!menu?.classList.contains('nav__menu--open')) return;
    const target = e.target as Node;
    if (!menu.contains(target) && !hamburger?.contains(target)) {
      menu.classList.remove('nav__menu--open');
      hamburger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('di-theme', theme);
    updateToggleIcon(theme);
  }

  function updateToggleIcon(theme: string) {
    const html = document.documentElement;
    if (theme === 'dark') {
      html.classList.add('theme--dark');
    } else {
      html.classList.remove('theme--dark');
    }
  }

  function getCurrentTheme(): string {
    const stored = localStorage.getItem('di-theme');
    if (stored) return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  // Init icon state on load
  updateToggleIcon(getCurrentTheme());

  themeToggle?.addEventListener('click', () => {
    const current = getCurrentTheme();
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });

</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin-inline: auto;
    padding: 0.75rem 1.5rem;
    min-height: 64px;
    position: relative;
  }

  @media (min-width: 900px) {
    .nav__container {
      padding: 0.75rem 2rem;
    }
  }

  .nav__logo {
    text-decoration: none;
    line-height: 0;
    padding: 0;
  }

  .nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
  }

  .nav__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  html.theme--dark .nav__hamburger span {
    background-color: var(--color-text);
  }

  .nav__menu {
    display: none;
    flex-direction: column;
    list-style: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
    padding: 0.5rem 1.25rem 1.25rem;
    margin: 0;
  }

  .nav__menu--open {
    display: flex;
  }

  .nav__menu a {
    display: block;
    padding: 0.75rem 0;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--color-surface);
  }

  .nav__menu li:last-child a {
    border-bottom: none;
  }

  .nav__active {
    color: var(--color-accent) !important;
  }

  @media (min-width: 900px) {
    .nav__hamburger {
      display: none;
    }

    .nav__menu {
      display: flex;
      flex-direction: row;
      align-items: center;
      position: static;
      box-shadow: none;
      padding: 0;
      gap: 1.5rem;
    }

    .nav__menu a {
      padding: 0;
      border-bottom: none;
      font-size: 0.875rem;
      white-space: nowrap;
    }

    .nav__menu a:hover {
      color: var(--color-accent);
    }
  }

  @media (min-width: 1100px) {
    .nav__menu {
      gap: 2rem;
    }

    .nav__menu a {
      font-size: 0.9375rem;
    }
  }

  /* Theme toggle */
  .nav__theme-item {
    display: flex;
    align-items: center;
  }

  .nav__theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: none;
    border: 1.5px solid rgba(15, 31, 61, 0.15);
    cursor: pointer;
    color: var(--color-text);
    transition: background-color 0.2s, border-color 0.2s;
    padding: 0;
  }

  .nav__theme-toggle:hover {
    background-color: var(--color-surface);
  }

  /* Show sun in dark mode, moon in light mode */
  .theme-icon--moon { display: block; }
  .theme-icon--sun  { display: none;  }

  html.theme--dark .theme-icon--moon { display: none;  }
  html.theme--dark .theme-icon--sun  { display: block; }

  /* Logo invert in dark mode */
  html.theme--dark .nav__logo-img {
    filter: brightness(0) invert(1);
  }

  /* On mobile: show toggle in menu row */
  @media (max-width: 899px) {
    .nav__theme-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--color-surface);
    }
  }

  /* On desktop: normal nav item */
  @media (min-width: 900px) {
    .nav__theme-toggle {
      border-color: rgba(15, 31, 61, 0.2);
    }
  }
</style>
